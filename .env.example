PORT=4000
NODE_ENV=development

# PostgreSQL via Prisma Postgres or standard pg URL
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=<your-api-key>"
# Or standard PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/animeunwatched"

# JWT secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Jikan anime catalog API
JIKAN_BASE_URL=https://api.jikan.moe/v4
CATALOG_PROVIDER=jikan

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3000

# Email (optional - set for production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@animeunwatched.com
SMTP_PASS=your-smtp-password

# Feature flags
ENABLE_EMAIL_NOTIFICATIONS=false
