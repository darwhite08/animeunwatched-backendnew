PORT=4000
NODE_ENV=development

# PostgreSQL (standard connection)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/animeunwatched"

# JWT secrets — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Jikan anime catalog API
JIKAN_BASE_URL=https://api.jikan.moe/v4
CATALOG_PROVIDER=jikan

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Publicly reachable callback base URL (use ngrok for mobile dev: `ngrok http 4000`)
OAUTH_CALLBACK_BASE=

# Apple Sign In — https://developer.apple.com/
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email (nodemailer) — optional, set for production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@animeunwatched.com
SMTP_PASS=your-smtp-password
ENABLE_EMAIL_NOTIFICATIONS=false

# Sentry error monitoring — get DSN from https://sentry.io (leave blank to disable)
SENTRY_DSN=
