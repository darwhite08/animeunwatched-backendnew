generator client {
  provider = "prisma-client"
  output   = "../app/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  MOD
  ADMIN
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
  REWATCHING   // Most-requested missing status (research finding)
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Auth & Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  /// URL-safe slug for human-readable routing. Derived from displayName at registration.
  /// Never used for data access — only for URL display. Always look up session userId internally.
  /// Nullable so existing users can be backfilled without data loss.
  slug         String?  @unique
  displayName  String
  bio          String?
  avatarUrl    String?
  passwordHash String  @default("")
  role         Role     @default(USER)
  reputation   Int      @default(0)
  isBanned     Boolean  @default(false)
  // Streak tracking — real database-backed (not rep estimate)
  streakDays   Int      @default(0)
  lastActiveAt DateTime?
  bestStreak   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])

  refreshTokens      RefreshToken[]
  following          Follow[]           @relation("Follower")
  followers          Follow[]           @relation("Following")
  listEntries        ListEntry[]
  posts              Post[]
  postLikes          PostLike[]
  postComments       PostComment[]
  ownedClubs         Club[]             @relation("ClubOwner")
  clubMemberships    ClubMember[]
  threads            Thread[]
  threadReplies      ThreadReply[]
  reviews            Review[]
  reviewLikes        ReviewLike[]
  blogs              Blog[]
  blogComments       BlogComment[]
  notifications      Notification[]
  reports            Report[]           @relation("Reporter")
  moderationActions  ModerationAction[]
  polls              Poll[]
  pollVotes          PollVote[]
  // OAuth providers linked to this account
  oauthProviders     UserOAuthProvider[]
  passwordResetTokens PasswordResetToken[]
  securityEvents      SecurityEvent[]
  // Chat
  publicKey          UserPublicKey?
  sentMessages       DirectMessage[]    @relation("MessageSender")
  conversations1     Conversation[]     @relation("ConvParticipant1")
  conversations2     Conversation[]     @relation("ConvParticipant2")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  // Session metadata — populated on issuance for the "active sessions" UI
  userAgent String?
  ipAddress String?
  lastUsedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // for the cleanup cron job
}

// Single-use password reset token. Created on POST /auth/forgot-password,
// consumed on POST /auth/reset-password. Hashed in storage to prevent
// DB-level token theft from being directly usable.
model PasswordResetToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique  // SHA-256 of the actual token sent to the user
  userId     String
  expiresAt  DateTime           // 1 hour from creation
  consumedAt DateTime?           // set on successful reset
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Append-only audit log for security-relevant events.
// type values: "login_success" | "login_failed" | "password_changed" |
//              "password_reset_requested" | "password_reset_completed" |
//              "account_deleted" | "session_revoked" | "logout_all"
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ---------------------------------------------------------------------------
// Anime catalog
// ---------------------------------------------------------------------------

model Anime {
  id             String    @id @default(cuid())
  malId          Int       @unique
  title          String
  titleEnglish   String?
  titleJapanese  String?
  synopsis       String?
  type           String?
  episodes       Int?
  status         String?
  airedFrom      DateTime?
  airedTo        DateTime?
  season         String?
  year           Int?
  rating         String?
  score          Float?
  imageUrl       String?
  trailerUrl     String?
  source         String?
  updatedAt      DateTime  @updatedAt

  genres      AnimeGenre[]
  studios     AnimeStudio[]
  listEntries ListEntry[]
  posts       Post[]
  threads     Thread[]
  reviews     Review[]

  @@index([malId])
  @@index([score])
}

model Genre {
  id   String @id @default(cuid())
  name String @unique

  animes AnimeGenre[]
}

model Studio {
  id   String @id @default(cuid())
  name String @unique

  animes AnimeStudio[]
}

model AnimeGenre {
  animeId String
  genreId String

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([animeId, genreId])
}

model AnimeStudio {
  animeId  String
  studioId String

  anime  Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([animeId, studioId])
}

// ---------------------------------------------------------------------------
// User watch list
// ---------------------------------------------------------------------------

model ListEntry {
  id           String      @id @default(cuid())
  userId       String
  animeId      String
  status       WatchStatus
  score        Int?
  episodesSeen Int         @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Posts (Twitter-style feed)
// ---------------------------------------------------------------------------

model Post {
  id        String    @id @default(cuid())
  authorId  String
  content   String
  animeId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  anime    Anime?        @relation(fields: [animeId], references: [id], onDelete: SetNull)
  likes    PostLike[]
  comments PostComment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([animeId])
}

model PostLike {
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ---------------------------------------------------------------------------
// Clubs
// ---------------------------------------------------------------------------

model Club {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  ownerId     String
  reputation  Int      @default(0)
  createdAt   DateTime @default(now())

  owner   User         @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members ClubMember[]
  threads Thread[]

  @@index([slug])
}

model ClubMember {
  userId   String
  clubId   String
  role     Role     @default(USER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
  @@index([clubId])
}

// ---------------------------------------------------------------------------
// Threads (Reddit-style discussion)
// ---------------------------------------------------------------------------

model Thread {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  clubId    String?
  animeId   String?
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  club    Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  anime   Anime?        @relation(fields: [animeId], references: [id], onDelete: SetNull)
  replies ThreadReply[]

  @@index([clubId, createdAt])
  @@index([animeId, createdAt])
  @@index([authorId])
}

model ThreadReply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  thread Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent ThreadReply? @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: SetNull)
  children ThreadReply[] @relation("ReplyToReply")

  @@index([threadId, createdAt])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id          String   @id @default(cuid())
  animeId     String
  authorId    String
  score       Int
  body        String
  hasSpoilers Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anime  Anime        @relation(fields: [animeId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  ReviewLike[]

  @@unique([animeId, authorId])
  @@index([animeId, createdAt])
  @@index([authorId])
}

model ReviewLike {
  userId   String
  reviewId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

// ---------------------------------------------------------------------------
// Blogs
// ---------------------------------------------------------------------------

model Blog {
  id          String     @id @default(cuid())
  slug        String     @unique
  authorId    String
  title       String
  body        String
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments BlogComment[]

  @@index([authorId])
  @@index([status, publishedAt])
}

model BlogComment {
  id        String   @id @default(cuid())
  blogId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  type        String
  payload     Json
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, read])
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetType, targetId])
}

model ModerationAction {
  id         String   @id @default(cuid())
  modId      String
  targetType String
  targetId   String
  action     String
  note       String?
  createdAt  DateTime @default(now())

  mod User @relation(fields: [modId], references: [id], onDelete: Cascade)

  @@index([modId])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Polls
// ---------------------------------------------------------------------------

model Poll {
  id        String   @id @default(cuid())
  question  String
  authorId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  author  User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([authorId])
  @@index([expiresAt])
}

model PollOption {
  id      String @id @default(cuid())
  pollId  String
  label   String
  order   Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  userId   String
  pollId   String
  optionId String

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([userId, pollId])
  @@index([pollId])
}

// ---------------------------------------------------------------------------
// OAuth providers
// ---------------------------------------------------------------------------

// One row per OAuth provider linked to a user account.
// Allows the same email to sign in via Google AND Apple without conflict.
model UserOAuthProvider {
  id         String   @id @default(cuid())
  userId     String
  provider   String   // "google" | "apple"
  providerId String   // Provider's stable user ID (sub claim)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Direct Messages — E2E Encrypted Chat
// ---------------------------------------------------------------------------

// Each user's ECDH P-256 public key (JWK JSON string).
// The private key never leaves the client.
model UserPublicKey {
  userId    String   @id
  publicKey String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A conversation between exactly two users.
// participant1 is always the lexicographically smaller userId to enforce uniqueness.
model Conversation {
  id           String   @id @default(cuid())
  participant1 String
  participant2 String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user1    User            @relation("ConvParticipant1", fields: [participant1], references: [id], onDelete: Cascade)
  user2    User            @relation("ConvParticipant2", fields: [participant2], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([participant1, participant2])
  @@index([participant1])
  @@index([participant2])
}

// A single encrypted message. The server stores ciphertext only — it cannot
// read the message content. Clients decrypt using their ECDH-derived shared secret.
model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  ciphertext     String    // AES-GCM encrypted content, base64
  iv             String    // AES-GCM IV, base64
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}
