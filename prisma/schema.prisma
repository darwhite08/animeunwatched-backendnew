generator client {
  provider = "prisma-client"
  output   = "../app/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  MOD
  ADMIN
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
  REWATCHING   // Most-requested missing status (research finding)
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Auth & Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  /// URL-safe slug for human-readable routing. Derived from displayName at registration.
  /// Never used for data access — only for URL display. Always look up session userId internally.
  /// Nullable so existing users can be backfilled without data loss.
  slug         String?  @unique
  displayName  String
  bio          String?
  avatarUrl    String?
  passwordHash String  @default("")
  role         Role     @default(USER)
  reputation   Int      @default(0)
  isBanned     Boolean  @default(false)
  bannedReason String?  // operator-supplied reason shown in admin tooling, null when not banned
  isShadowBanned Boolean @default(false)  // soft moderation: user can post but content is hidden from others
  isPrivate    Boolean  @default(false)   // private account (Instagram-style): followers need approval
  // DM privacy (DM v2). Who may start a DM, whether read receipts are sent,
  // and who may see online/last-seen status. Enforced server-side.
  dmPrivacy        String  @default("everyone")   // everyone | followers | nobody
  readReceiptsOn   Boolean @default(true)
  showOnlineStatus String  @default("everyone")   // everyone | followers | nobody
  dmLastSeenAt     DateTime?                       // presence "last seen" (throttled writes)
  // Streak tracking — real database-backed (not rep estimate). See
  // docs/streak-algorithm.md: timezone-correct day boundary + grace + freezes +
  // soft-break + repair (humane, anti-frustration).
  streakDays   Int      @default(0)
  lastActiveAt DateTime?
  bestStreak   Int      @default(0)
  /// Local-day key "YYYY-MM-DD" (in `timezone`, grace-shifted) the streak was
  /// last credited — the REAL consecutive-day comparison key (not a UTC ts).
  lastStreakDate String?
  /// IANA tz for the user's day boundary (fixes the UTC-midnight churn bug).
  timezone     String   @default("Asia/Kolkata")
  /// Auto-consumed freeze tokens that absorb a missed day (Duolingo-style).
  streakFreezes   Int    @default(0)
  freezeGrantedAt DateTime?            // weekly earn-cap anchor
  streakRepairAt  DateTime?            // last free repair (monthly cap)
  streakBrokenAt  DateTime?            // when the last break happened (48h repair window)
  prevStreakDays  Int    @default(0)   // streak value just before a break (for repair)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])

  refreshTokens      RefreshToken[]
  following          Follow[]           @relation("Follower")
  followers          Follow[]           @relation("Following")
  listEntries        ListEntry[]
  posts              Post[]
  postLikes          PostLike[]
  postComments       PostComment[]
  postCommentLikes   PostCommentLike[]
  postHides          PostHide[]
  ownedClubs         Club[]             @relation("ClubOwner")
  clubMemberships    ClubMember[]
  threads            Thread[]
  threadReplies      ThreadReply[]
  reviews            Review[]
  reviewLikes        ReviewLike[]
  blogs              Blog[]
  blogComments       BlogComment[]
  notifications      Notification[]
  reports            Report[]           @relation("Reporter")
  moderationActions  ModerationAction[]
  polls              Poll[]
  pollVotes          PollVote[]
  // OAuth providers linked to this account
  oauthProviders     UserOAuthProvider[]
  passwordResetTokens PasswordResetToken[]
  securityEvents      SecurityEvent[]
  // Chat
  publicKey          UserPublicKey?
  deviceKeys         UserDeviceKey[]    // multi-device E2E (Phase 1, additive)
  // Shots (short vertical videos)
  shots              Shot[]
  shotLikes          ShotLike[]
  // Peeak (24h stories)
  stories            Story[]
  storyViews         StoryView[]
  sentMessages       DirectMessage[]    @relation("MessageSender")
  conversations1     Conversation[]     @relation("ConvParticipant1")
  conversations2     Conversation[]     @relation("ConvParticipant2")
  // Push notification device tokens
  deviceTokens       DeviceToken[]
  nativePushTokens   NativePushToken[] // Capacitor FCM/APNs tokens (additive)
  messageReactions   MessageReaction[]
  // Activity feed (FEED_FEATURES §12 — MVP)
  activities         Activity[]
  activityLikes      ActivityLike[]
  activityReposts    ActivityRepost[]
  replies            Reply[]
  // SCIM 2.0 provisioning mapping (optional — only populated if an IdP provisioned this user)
  scimSubject        ScimSubject?
  // DM safety + privacy (DM v2)
  blocksMade         UserBlock[]        @relation("blocksMade")
  blocksReceived     UserBlock[]        @relation("blocksReceived")
  // DM E2EE layer
  e2eDevices         UserDevice[]
  e2eKeyWraps        UserMasterKeyWrap[]
  // Club 2.0 — events
  clubEventsCreated  ClubEvent[]         @relation("ClubEventCreator")
  threadReactions    ThreadReaction[]
  clubEventRsvps     ClubEventRSVP[]
  // Private clubs — invites + join requests
  clubInvitesCreated ClubInvite[]        @relation("ClubInviteCreator")
  clubJoinRequests   ClubJoinRequest[]   @relation("ClubJoinRequestUser")
  // Group chat (parallel to 1:1 DM — does not touch the locked direct system)
  groupsOwned        GroupConversation[] @relation("GroupOwner")
  groupMemberships   GroupMember[]
  groupMessages      GroupMessage[]      @relation("GroupMessageSender")
  groupReactions     GroupMessageReaction[]
  streakDaysLog      StreakDay[]
  // Creator monetization (docs/monetization-system.md)
  creatorProfile     CreatorProfile?
  creatorTiers       CreatorTier[]
  membershipsAsFan     CreatorMembership[] @relation("FanMemberships")
  membershipsAsCreator CreatorMembership[] @relation("CreatorMemberships")
  tipsSent           Tip[]              @relation("TipsSent")
  tipsReceived       Tip[]              @relation("TipsReceived")
  creatorEarnings    CreatorEarning[]
  payoutAccount      PayoutAccount?
  payouts            Payout[]
  // Connected external accounts (Instagram, …) + imported media dedup
  socialConnections  SocialConnection[]
  importedMedia      ImportedMedia[]
}

// ---------------------------------------------------------------------------
// Creator monetization — fan-funding (memberships + tips + paid unlocks),
// 90/10 split. docs/monetization-system.md. Money is always integer cents.
// ---------------------------------------------------------------------------

model CreatorProfile {
  userId         String   @id
  status         String   @default("none")   // none | pending | eligible | active | suspended
  isEligible     Boolean  @default(false)
  eligibleAt     DateTime?
  payoutCountry  String?                       // ISO-2; routes to Stripe vs PayPal rail
  defaultCurrency String  @default("USD")
  // Cached eligibility snapshot (recomputed on demand)
  followersAtCheck Int    @default(0)
  reputationAtCheck Int   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreatorTier {
  id          String   @id @default(cuid())
  creatorId   String
  name        String
  description String?
  priceCents  Int                              // monthly price
  currency    String   @default("USD")
  perks       String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  memberships CreatorMembership[]

  @@index([creatorId, active])
}

model CreatorMembership {
  id               String   @id @default(cuid())
  fanId            String
  creatorId        String
  tierId           String
  status           String   @default("active") // active | canceled | past_due
  currentPeriodEnd DateTime?
  provider         String   @default("stripe")  // stripe | paypal | simulated
  providerSubId    String?
  createdAt        DateTime @default(now())
  canceledAt       DateTime?

  fan     User        @relation("FanMemberships",     fields: [fanId],     references: [id], onDelete: Cascade)
  creator User        @relation("CreatorMemberships", fields: [creatorId], references: [id], onDelete: Cascade)
  tier    CreatorTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([fanId, creatorId])   // one active membership per fan→creator
  @@index([creatorId, status])
}

model Tip {
  id          String   @id @default(cuid())
  fromUserId  String
  toCreatorId String
  amountCents Int
  currency    String   @default("USD")
  message     String?
  targetType  String?                          // "blog" | "activity" | "profile"
  targetId    String?
  provider    String   @default("stripe")
  providerRef String?
  createdAt   DateTime @default(now())

  fromUser  User @relation("TipsSent",     fields: [fromUserId],  references: [id], onDelete: Cascade)
  toCreator User @relation("TipsReceived", fields: [toCreatorId], references: [id], onDelete: Cascade)

  @@index([toCreatorId, createdAt])
}

// Append-only earnings ledger — the single source of truth for the Patreon-style
// funnel: gross → processorFee → platformFee(10%) → net.
model CreatorEarning {
  id            String   @id @default(cuid())
  creatorId     String
  source        String                          // membership | tip | unlock
  sourceId      String?                          // membership/tip/unlock id
  grossCents    Int
  processorFeeCents Int   @default(0)
  platformFeeCents  Int                          // 10% of gross
  netCents      Int                              // gross − processorFee − platformFee
  currency      String   @default("USD")
  status        String   @default("pending")     // pending(hold) | available | paid | refunded
  availableAt   DateTime                         // when it leaves the 7-day hold
  payoutId      String?
  createdAt     DateTime @default(now())

  creator User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  payout  Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([creatorId, status])
  @@index([creatorId, createdAt])
}

model PayoutAccount {
  userId        String   @id
  provider      String                           // stripe | paypal
  providerAcctId String?
  onboarded     Boolean  @default(false)
  taxFormStatus String   @default("missing")     // missing | submitted
  payoutsEnabled Boolean @default(false)
  country       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payout {
  id          String   @id @default(cuid())
  creatorId   String
  amountCents Int
  currency    String   @default("USD")
  provider    String                             // stripe | paypal
  status      String   @default("requested")     // requested | processing | paid | failed
  providerRef String?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime @default(now())
  paidAt      DateTime?

  creator  User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  earnings CreatorEarning[]

  @@index([creatorId, createdAt])
}

// One row per user per active local day. Powers the streak "Consistency Map"
// heatmap and is the audit trail for how each day was credited (docs/streak-algorithm.md).
model StreakDay {
  userId        String
  date          String   // local-day key "YYYY-MM-DD" (user's tz, grace-shifted)
  activityCount Int      @default(1)
  source        String   @default("activity") // activity | frozen | grace | repair
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([userId, date])
}

// One row per registered push-notification device for a user.
// A user can have many (phone + tablet + work device, etc.).
// Token uniqueness across users: a given Expo push token belongs to ONE device,
// so if it's seen on a new userId we transfer ownership rather than duplicate.
model DeviceToken {
  id          String   @id @default(cuid())
  userId      String
  expoToken   String   @unique
  platform    String   // "ios" | "android" | "web"
  deviceName  String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Capacitor native push tokens (FCM on Android / APNs via FCM on iOS). Separate
// from DeviceToken (Expo) because the token formats + send paths differ.
model NativePushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   // "ios" | "android"
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  // Session metadata — populated on issuance for the "active sessions" UI
  userAgent String?
  ipAddress String?
  lastUsedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // for the cleanup cron job
}

// Single-use password reset token. Created on POST /auth/forgot-password,
// consumed on POST /auth/reset-password. Hashed in storage to prevent
// DB-level token theft from being directly usable.
model PasswordResetToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique  // SHA-256 of the actual token sent to the user
  userId     String
  expiresAt  DateTime           // 1 hour from creation
  consumedAt DateTime?           // set on successful reset
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Append-only audit log for security-relevant events.
// type values: "login_success" | "login_failed" | "password_changed" |
//              "password_reset_requested" | "password_reset_completed" |
//              "account_deleted" | "session_revoked" | "logout_all"
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum FollowStatus {
  PENDING   // request awaiting approval (target is a private account)
  ACCEPTED  // active follow
}

model Follow {
  followerId  String
  followingId String
  status      FollowStatus @default(ACCEPTED)
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followingId, status])
}

// ---------------------------------------------------------------------------
// Anime catalog
// ---------------------------------------------------------------------------

// How aggressively the sync worker refreshes an anime from Jikan.
//   HOT    — currently airing / airing within 60 days (refresh every ~6h)
//   NORMAL — everything else (refresh every ~7 days)
//   COLD   — finished 2+ years ago, or repeatedly failing (refresh every ~30 days)
enum SyncPriority {
  HOT
  NORMAL
  COLD
}

model Anime {
  id             String    @id @default(cuid())
  malId          Int       @unique
  /// SEO-friendly slug ("fullmetal-alchemist-brotherhood"). Set ONCE on first
  /// full sync and never changed (stable URLs). Nullable so pre-existing rows
  /// can be backfilled lazily — same pattern as User.slug.
  slug           String?   @unique
  title          String
  titleEnglish   String?
  titleJapanese  String?
  titleSynonyms  String[]  @default([])
  synopsis       String?
  background     String?
  type           String?
  episodes       Int?      // total episode count from Jikan (null = unknown/ongoing)
  status         String?
  airing         Boolean   @default(false)
  airedFrom      DateTime?
  airedTo        DateTime?
  duration       String?
  season         String?
  year           Int?
  rating         String?
  score          Float?
  scoredBy       Int?
  rank           Int?
  popularity     Int?
  membersCount   Int?
  favoritesCount Int?
  imageUrl       String?   // large JPG — kept as the canonical field the frontend reads
  imageSmallUrl  String?
  imageWebpUrl   String?
  /// Reserved for a future CDN-mirroring phase. Never written by sync.
  localImagePath String?
  trailerUrl     String?
  trailerYoutubeId String?
  broadcastDay   String?
  broadcastTime  String?
  broadcastTz    String?
  source         String?

  // ── Sync bookkeeping ──
  /// Null = never fully synced from /anime/{id}/full (row came from a list/
  /// search payload or predates the sync worker).
  lastSyncedAt   DateTime?
  syncPriority   SyncPriority @default(NORMAL)
  syncFailCount  Int       @default(0)
  /// True when the row was created from a search/list payload and the full
  /// detail fetch hasn't happened yet.
  isStub         Boolean   @default(false)

  // ── Kaiveron-native enrichment — NEVER overwritten by sync ──
  kaiveronTags   String[]  @default([])
  waieScore      Float?
  isFeatured     Boolean   @default(false)

  /// Resolved English Wikipedia article title for pageview-buzz lookups, cached
  /// once via MediaWiki search. null = not yet resolved; "" = no confident article.
  wikipediaTitle String?

  // ── "Trending Now" — computed by the compute-trending worker (docs/trending-algorithm.md).
  // Read path is a single indexed ORDER BY trendingScore; never recomputed at request time.
  trendingScore     Float?    @default(0)
  trendingRank      Int?
  trendingUpdatedAt DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  genres      AnimeGenre[]
  studios     AnimeStudio[]
  episodeList Episode[]
  relations   AnimeRelation[] @relation("RelationSource")
  relatedTo   AnimeRelation[] @relation("RelationTarget")
  listEntries ListEntry[]
  posts       Post[]
  threads     Thread[]
  reviews     Review[]
  activities  Activity[]
  shots       Shot[]
  trendingState TrendingState?

  @@index([malId])
  @@index([slug])
  @@index([score])
  @@index([popularity])
  @@index([season, year])
  @@index([status, syncPriority])
  @@index([syncPriority, lastSyncedAt])
  @@index([title])
  @@index([trendingScore])
}

// Per-title streaming state for the trending detector. Holds only O(1)-sized
// recursive statistics (a handful of floats) so each refresh updates in
// constant time with NO history rescan (see docs/trending-algorithm.md §11b):
//   - ewmaMean/ewmaDev  → robust-z baseline (MAD ≈ 1.4826·ewmaDev)
//   - newmaFast/newmaSlow → NEWMA spike detector (two-EWMA comparison)
//   - seasonal[7]       → S-H-ESD weekly deseasonalization (per-weekday EWMA)
//   - prevScore         → EWMA smoothing across ticks (anti-flicker)
model TrendingState {
  animeId    String   @id
  ewmaMean   Float    @default(0)   // EWMA mean of deseasonalized velocity residual
  ewmaDev    Float    @default(0)   // EWMA mean-abs-deviation → robust scale
  newmaFast  Float    @default(0)   // fast EWMA of velocity
  newmaSlow  Float    @default(0)   // slow EWMA of velocity
  seasonal   Json     @default("[0,0,0,0,0,0,0]")  // per-weekday seasonal EWMA (Sun..Sat)
  lastVel    Float    @default(0)   // last raw decayed velocity (debug/inspect)
  prevScore  Float    @default(0)   // last smoothed trendingScore
  samples    Int      @default(0)   // updates seen (cold-start warmup)
  // Off-platform web buzz (AniList trending + Wikimedia pageviews), normalized
  // 0..1, refreshed by the compute-buzz tick. Lets a title trend on web activity
  // even with no on-platform engagement yet.
  externalBuzz Float   @default(0)
  buzzAt     DateTime?
  // Score component breakdown for "why is this trending" UI + tuning/debug:
  // { burst, magnitude, newma, web, anilist, wikipedia } weighted contributions.
  components Json?
  updatedAt  DateTime @updatedAt

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
}

model Genre {
  id    String @id @default(cuid())
  name  String @unique
  /// Jikan/MAL genre id. Nullable: pre-existing rows were keyed by name only
  /// and are backfilled as full syncs run.
  malId Int?   @unique
  /// genre | explicit_genre | theme | demographic (Jikan's four genre buckets)
  type  String @default("genre")

  animes AnimeGenre[]
}

model Studio {
  id    String @id @default(cuid())
  name  String @unique
  /// Jikan/MAL producer id. Nullable for pre-existing name-only rows.
  malId Int?   @unique

  animes AnimeStudio[]
}

model AnimeGenre {
  animeId String
  genreId String

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([animeId, genreId])
}

model AnimeStudio {
  animeId  String
  studioId String
  /// studio | producer | licensor (Jikan's three company roles)
  role     String @default("studio")

  anime  Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([animeId, studioId, role])
}

model Episode {
  id            String    @id @default(cuid())
  animeId       String
  malEpisodeId  Int       // episode number on MAL
  title         String?
  titleJapanese String?
  titleRomaji   String?
  aired         DateTime?
  score         Float?
  filler        Boolean   @default(false)
  recap         Boolean   @default(false)
  synopsis      String?

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, malEpisodeId])
  @@index([animeId])
}

model AnimeRelation {
  id           String  @id @default(cuid())
  sourceId     String
  targetMalId  Int     // target may not exist locally yet
  targetId     String? // resolved local id when available
  relationType String  // Sequel, Prequel, Adaptation, Side story...

  source Anime  @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Anime? @relation("RelationTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@unique([sourceId, targetMalId, relationType])
  @@index([targetMalId])
}

// ---------------------------------------------------------------------------
// Anime sync — Postgres-backed job queue + audit log
// The repo deliberately has no Redis/BullMQ (see lib/jobRegistry.ts); pending
// sync work is durable rows here, drained by an in-process worker loop that
// shares the global Jikan rate limiter.
// ---------------------------------------------------------------------------

model SyncJob {
  id          String    @id @default(cuid())
  /// sync-anime-full | sync-episodes | seed-top | seed-season |
  /// refresh-hot | refresh-normal | refresh-cold
  jobType     String
  payload     Json
  /// Dedupe anchor, e.g. "sync-anime-full:5114". Cleared when the job
  /// finishes so the same work can be re-enqueued later.
  dedupeKey   String?   @unique
  status      String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  priority    Int       @default(0)         // higher runs first
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())     // not claimable before this
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt, priority])
  @@index([jobType, status])
}

model SyncJobLog {
  id         String   @id @default(cuid())
  jobType    String
  malId      Int?
  status     String   // success | failed | skipped
  error      String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([jobType, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// User watch list
// ---------------------------------------------------------------------------

model ListEntry {
  id           String      @id @default(cuid())
  userId       String
  animeId      String
  status       WatchStatus
  score        Int?
  episodesSeen Int         @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Posts (Twitter-style feed)
// ---------------------------------------------------------------------------

model Post {
  id        String    @id @default(cuid())
  authorId  String
  content   String
  animeId   String?
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Trending-algorithm admin overrides. Per HN's pattern of manually
  // penalizing ~20% of front-page stories — pure formulas always need a
  // human escape hatch. Default 1.0 = no effect on the multiplicative score.
  //   manualBoost   > 1 promotes (no enforced ceiling; admin UI clamps)
  //   shadowPenalty < 1 demotes silently without hiding the post
  manualBoost   Float @default(1.0)
  shadowPenalty Float @default(1.0)

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  anime    Anime?        @relation(fields: [animeId], references: [id], onDelete: SetNull)
  likes    PostLike[]
  comments PostComment[]
  hides    PostHide[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([animeId])
}

// "Not interested" — user-driven negative signal. Per X's open-sourced
// algorithm, negative signals weigh ~5–10× a positive one (report=-369 vs
// favorite=+0.5). A single Hide drops the post completely from the hider's
// trending feed. Hides also accumulate at the AUTHOR level: when a user
// hides ≥3 posts from the same author, that author's posts get a strong
// soft-block (×0.2) for that viewer in subsequent trending requests.
model PostHide {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
}

model PostLike {
  userId String
  postId String
  createdAt DateTime @default(now())   // for creator-analytics time-windowing

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostComment {
  id              String   @id @default(cuid())
  postId          String
  authorId        String
  content         String
  // Self-recursive parent → builds nested reply chains ("thread strings").
  parentCommentId String?
  // Denormalized engagement counters (always updated in the same transaction
  // as the underlying like / reply write).
  likeCount       Int      @default(0)
  replyCount      Int      @default(0)
  createdAt       DateTime @default(now())

  post   Post          @relation(fields: [postId],          references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId],        references: [id], onDelete: Cascade)
  parent PostComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")
  likes  PostCommentLike[]

  @@index([postId, parentCommentId, createdAt])
  @@index([parentCommentId, createdAt])
}

model PostCommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId],    references: [id], onDelete: Cascade)
  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

// ---------------------------------------------------------------------------
// Clubs
// ---------------------------------------------------------------------------

model Club {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  category    String?
  ownerId     String
  reputation  Int      @default(0)
  createdAt   DateTime @default(now())
  // Club 2.0 — identity + onboarding
  bannerUrl      String?
  avatarUrl      String?
  rules          String?  @db.Text
  welcomeMessage String?  @db.Text
  // Private clubs — gate joins behind invite/approval
  visibility     ClubVisibility @default(PUBLIC)

  owner   User         @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members ClubMember[]
  threads Thread[]
  events  ClubEvent[]
  polls   Poll[]
  invites      ClubInvite[]
  joinRequests ClubJoinRequest[]
  // Optional realtime chat room for the club (a club-backed GroupConversation).
  chatGroup GroupConversation? @relation("ClubChat")

  @@index([slug])
  @@index([createdAt])
  @@index([reputation, createdAt])
}

enum ClubVisibility {
  PUBLIC
  PRIVATE
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Shareable invite link for a (typically private) club. Joining via a valid
// invite bypasses the approval queue.
model ClubInvite {
  id          String    @id @default(cuid())
  clubId      String
  code        String    @unique
  createdById String
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  createdAt   DateTime  @default(now())

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User @relation("ClubInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([code])
}

// Pending membership request for a private club (one open request per user/club).
model ClubJoinRequest {
  id          String            @id @default(cuid())
  clubId      String
  userId      String
  status      JoinRequestStatus @default(PENDING)
  message     String?           @db.Text
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?
  decidedById String?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation("ClubJoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId, status])
}

enum ClubEventKind {
  WATCH_PARTY
  AMA
  GAME_NIGHT
  GENERAL
}

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
}

// Scheduled club event (watch-party / AMA / game night). The headline P0 feature.
model ClubEvent {
  id            String        @id @default(cuid())
  clubId        String
  creatorId     String
  title         String
  description   String?       @db.Text
  kind          ClubEventKind @default(WATCH_PARTY)
  animeMalId    Int?
  episodeNumber Int?
  startsAt      DateTime
  endsAt        DateTime?
  location      String?       // "club chat" | external URL
  remindedAt    DateTime?     // last reminder dispatch (cron)
  createdAt     DateTime      @default(now())

  club    Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  creator User             @relation("ClubEventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps   ClubEventRSVP[]

  @@index([clubId, startsAt])
  @@index([startsAt])
}

model ClubEventRSVP {
  eventId   String
  userId    String
  status    RSVPStatus @default(GOING)
  createdAt DateTime   @default(now())

  event ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model ClubMember {
  userId   String
  clubId   String
  role     Role     @default(USER)
  joinedAt DateTime @default(now())
  // Club 2.0 — onboarding + gamification
  agreedRulesAt DateTime?
  onboardedAt   DateTime?
  xp            Int       @default(0)
  lastXpAt      DateTime?
  // Moderation
  mutedUntil    DateTime?
  strikes       Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
  @@index([clubId])
  @@index([clubId, xp])
}

// Emoji reactions on a Thread or a ThreadReply (polymorphic targetId).
model ThreadReaction {
  id         String   @id @default(cuid())
  targetId   String   // Thread.id or ThreadReply.id
  targetType String   // "thread" | "reply"
  userId     String
  emoji      String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetId, userId, emoji])
  @@index([targetId])
}

// ---------------------------------------------------------------------------
// Threads (Reddit-style discussion)
// ---------------------------------------------------------------------------

enum ThreadKind {
  DISCUSSION
  ANNOUNCEMENT
  CHALLENGE
  EPISODE
}

model Thread {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  clubId    String?
  animeId   String?
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  kind          ThreadKind @default(DISCUSSION)
  pinnedUntil   DateTime?
  episodeNumber Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  club    Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  anime   Anime?        @relation(fields: [animeId], references: [id], onDelete: SetNull)
  replies ThreadReply[]

  @@index([clubId, createdAt])
  @@index([animeId, createdAt])
  @@index([authorId])
}

model ThreadReply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  thread Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent ThreadReply? @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: SetNull)
  children ThreadReply[] @relation("ReplyToReply")

  @@index([threadId, createdAt])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id          String   @id @default(cuid())
  animeId     String
  authorId    String
  score       Int
  body        String
  hasSpoilers Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anime  Anime        @relation(fields: [animeId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  ReviewLike[]

  @@unique([animeId, authorId])
  @@index([animeId, createdAt])
  @@index([authorId])
}

model ReviewLike {
  userId   String
  reviewId String
  createdAt DateTime @default(now())   // for creator-analytics time-windowing

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

// ---------------------------------------------------------------------------
// Blogs
// ---------------------------------------------------------------------------

model Blog {
  id          String     @id @default(cuid())
  slug        String     @unique
  authorId    String
  title       String
  body        String
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments BlogComment[]

  @@index([authorId])
  @@index([status, publishedAt])
}

model BlogComment {
  id        String   @id @default(cuid())
  blogId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  type        String
  payload     Json
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, read])
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetType, targetId])
}

model ModerationAction {
  id         String   @id @default(cuid())
  modId      String
  targetType String
  targetId   String
  action     String
  note       String?
  createdAt  DateTime @default(now())

  mod User @relation(fields: [modId], references: [id], onDelete: Cascade)

  @@index([modId])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Polls
// ---------------------------------------------------------------------------

model Poll {
  id        String   @id @default(cuid())
  question  String
  authorId  String
  clubId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  author  User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  club    Club?      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([authorId])
  @@index([expiresAt])
  @@index([clubId])
}

model PollOption {
  id      String @id @default(cuid())
  pollId  String
  label   String
  order   Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  userId   String
  pollId   String
  optionId String

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([userId, pollId])
  @@index([pollId])
}

// ---------------------------------------------------------------------------
// OAuth providers
// ---------------------------------------------------------------------------

// One row per OAuth provider linked to a user account.
// Allows the same email to sign in via Google AND Apple without conflict.
model UserOAuthProvider {
  id         String   @id @default(cuid())
  userId     String
  provider   String   // "google" | "apple"
  providerId String   // Provider's stable user ID (sub claim)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Direct Messages — E2E Encrypted Chat
// ---------------------------------------------------------------------------

// Each user's ECDH P-256 public key (JWK JSON string).
// The private key never leaves the client.
model UserPublicKey {
  userId    String   @id
  publicKey String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A conversation between exactly two users.
// participant1 is always the lexicographically smaller userId to enforce uniqueness.
model Conversation {
  id           String   @id @default(cuid())
  participant1 String
  participant2 String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // DM v2 — message-request state. A conversation starts PENDING when the
  // initiator isn't followed back by the recipient (privacy-dependent), else
  // ACTIVE. DECLINED conversations reject further messages from the initiator.
  status        ConversationStatus @default(ACTIVE)
  initiatorId   String?                              // who sent the first message
  // Denormalized sort/cursor key for the inbox (cheaper than joining messages).
  lastMessageAt DateTime @default(now())

  // Per-participant state (denormalized for cheap inbox queries). p1/p2 map to
  // participant1/participant2 (canonical lexicographic order).
  p1UnreadCount Int      @default(0)
  p2UnreadCount Int      @default(0)
  p1MutedUntil  DateTime?
  p2MutedUntil  DateTime?
  p1DeletedAt   DateTime?            // "delete conversation for me" — hide messages before this
  p2DeletedAt   DateTime?
  p1LastReadAt  DateTime?
  p2LastReadAt  DateTime?
  p1Pinned      Boolean  @default(false)
  p2Pinned      Boolean  @default(false)
  p1Archived    Boolean  @default(false)
  p2Archived    Boolean  @default(false)
  // Disappearing messages — conversation-wide TTL in seconds (null = off).
  disappearingSeconds Int?

  user1    User            @relation("ConvParticipant1", fields: [participant1], references: [id], onDelete: Cascade)
  user2    User            @relation("ConvParticipant2", fields: [participant2], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([participant1, participant2])
  @@index([participant1, lastMessageAt])
  @@index([participant2, lastMessageAt])
  @@index([status])
}

enum ConversationStatus {
  ACTIVE
  PENDING
  DECLINED
}

// A single encrypted message. The server stores ciphertext only — it cannot
// read the message content. Clients decrypt using their ECDH-derived shared secret.
model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  deliveredAt    DateTime?            // set when recipient's socket is connected

  // DM v2 — server-readable content (TLS in transit). `body` holds text or a
  // media caption. Legacy E2E rows keep ciphertext/iv and leave body null.
  type           MessageType @default(TEXT)
  body           String?     @db.Text
  // Spoiler segments (||spoiler||) are parsed client-side. animeRef enables
  // progress-aware gating for ANIME_CARD and tagged messages.
  animeMalId     Int?
  animeEpisode   Int?                 // recipient client blurs when their progress < episode

  // Media (IMAGE / VOICE)
  mediaUrl       String?
  mediaMime      String?
  mediaSizeBytes Int?
  mediaWidth     Int?
  mediaHeight    Int?
  mediaDurationS Int?                 // voice notes
  mediaBlurhash  String?              // blurred image placeholder

  replyToId      String?
  replyTo        DirectMessage?  @relation("DMReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        DirectMessage[] @relation("DMReplies")

  editedAt       DateTime?
  clientNonce    String?              // client-generated id for optimistic UI dedup
  expiresAt      DateTime?            // disappearing messages — purged + hidden after this

  // Encrypted content. DM-v2 plaintext rows leave these null and use `body`;
  // E2EE rows (isE2EE) set ciphertext/contentIv and leave body null (dual-read).
  // Stored base64 (repo convention) rather than Prisma Bytes.
  ciphertext     String?    // AES-GCM(CK, {text,frankingKey}) base64
  iv             String?    // legacy pairwise IV (pre-v2)
  contentIv      String?    // AES-GCM content IV for E2EE rows, base64
  frankingTag    String?    // HMAC-SHA256(frankingKey, plaintext), base64
  serverFrank    String?    // HMAC(SERVER_FRANK_SECRET, frankingTag‖id‖sender‖ts), base64
  isE2EE         Boolean    @default(false)
  envelopesV2    MessageEnvelope[]

  // WhatsApp-style deletion model:
  // - deletedAt: "Delete for everyone" (sender, within window); body/media/
  //   ciphertext cleared, clients render a tombstone for both users.
  // - deletedForSender / deletedForRecipient: "Delete for me".
  deletedAt             DateTime?
  deletedForSender      Boolean   @default(false)
  deletedForRecipient   Boolean   @default(false)

  // Multi-device E2E (legacy Phase 1, additive). Unused by v2 server-readable.
  senderDeviceKeyId String?

  conversation    Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderDeviceKey UserDeviceKey?      @relation("MsgSenderDeviceKey", fields: [senderDeviceKeyId], references: [id])
  envelopes       MessageKeyEnvelope[]
  reactions       MessageReaction[]

  @@unique([conversationId, clientNonce])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([expiresAt])
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  ANIME_CARD
  SYSTEM
}

// Emoji reactions on a direct message. One row per (message, user, emoji).
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ─────────────────────────────────────────────────────────────────────────────
// GROUP CHAT (parallel to the 1:1 DM system). Separate tables on purpose — the
// direct-message realtime/unread path is LOCKED and must not change. N members,
// per-member denormalized unread/read/mute/archive state, optional E2EE via the
// SAME per-device key infrastructure (UserDevice + per-message envelopes).
// ─────────────────────────────────────────────────────────────────────────────
model GroupConversation {
  id            String   @id @default(cuid())
  title         String
  avatarUrl     String?
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())
  // Disappearing messages — group-wide TTL in seconds (null = off).
  disappearingSeconds Int?
  // When true, members send opaque ciphertext + per-device envelopes.
  isE2EE        Boolean  @default(false)
  // If set, this group is the chat room for a Club; membership mirrors ClubMember.
  clubId        String?  @unique

  owner    User           @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  messages GroupMessage[]
  club     Club?          @relation("ClubChat", fields: [clubId], references: [id], onDelete: Cascade)

  @@index([lastMessageAt])
  @@index([ownerId])
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model GroupMember {
  id          String          @id @default(cuid())
  groupId     String
  userId      String
  role        GroupMemberRole @default(MEMBER)
  joinedAt    DateTime        @default(now())
  addedBy     String?
  // Per-member denormalized inbox state (mirrors the p1/p2 columns on 1:1).
  unreadCount Int             @default(0)
  lastReadAt  DateTime?
  mutedUntil  DateTime?
  archived    Boolean         @default(false)
  pinned      Boolean         @default(false)
  // "Left the group" — soft so history/attribution survives. Active members have null.
  leftAt      DateTime?

  group GroupConversation @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, archived])
  @@index([groupId])
}

model GroupMessage {
  id          String      @id @default(cuid())
  groupId     String
  senderId    String?     // null for SYSTEM events (joined/left/renamed)
  createdAt   DateTime    @default(now())

  type        MessageType @default(TEXT)
  body        String?     @db.Text
  animeMalId  Int?
  animeEpisode Int?

  // Media (IMAGE / VOICE) — clear URL + dims for plaintext, opaque blob for E2EE.
  mediaUrl       String?
  mediaMime      String?
  mediaSizeBytes Int?
  mediaWidth     Int?
  mediaHeight    Int?
  mediaDurationS Int?
  mediaBlurhash  String?

  replyToId   String?
  replyTo     GroupMessage?  @relation("GroupReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     GroupMessage[] @relation("GroupReplies")

  editedAt    DateTime?
  clientNonce String?
  expiresAt   DateTime?

  // E2EE (optional) — opaque ciphertext + franking; body stays null when set.
  ciphertext  String?
  contentIv   String?
  frankingTag String?
  serverFrank String?
  isE2EE      Boolean   @default(false)

  // "Delete for everyone" tombstone. Per-member "delete for me" lives in the
  // GroupMessageHide table (cheaper than a boolean column per member).
  deletedAt   DateTime?

  group     GroupConversation      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User?                  @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  envelopes GroupMessageEnvelope[]
  reactions GroupMessageReaction[]
  hides     GroupMessageHide[]

  @@unique([groupId, clientNonce])
  @@index([groupId, createdAt])
  @@index([senderId])
  @@index([expiresAt])
}

// Per-recipient-device wrapped CK for E2EE group messages (mirrors MessageEnvelope).
model GroupMessageEnvelope {
  id           String       @id @default(cuid())
  messageId    String
  message      GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  deviceId     String       // references UserDevice.id (no FK to keep groups self-contained)
  ephemeralPub String
  wrappedCK    String
  wrapIv       String

  @@unique([messageId, deviceId])
  @@index([deviceId])
}

model GroupMessageReaction {
  id        String       @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime     @default(now())

  message GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// "Delete for me" on a group message — one row per (message, user).
model GroupMessageHide {
  messageId String
  userId    String
  message   GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

// Multi-device E2E (Phase 1). Each device registers its own ECDH P-256 public
// key (JWK JSON). Many per user — replaces the single-key UserPublicKey going
// forward; existing UserPublicKey rows are backfilled here as deviceId "legacy".
model UserDeviceKey {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String   // stable client-generated id (e.g. random, stored locally)
  publicKey String   // ECDH P-256 public key, JWK JSON string
  createdAt DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentMessages   DirectMessage[]      @relation("MsgSenderDeviceKey")
  envelopes      MessageKeyEnvelope[]

  @@unique([userId, deviceId])
  @@index([userId])
}

// Per-recipient-device wrapped copy of a message's random AES key. The server
// stores only wrapped key material — it still cannot read message content.
model MessageKeyEnvelope {
  id                   String @id @default(cuid())
  messageId            String
  recipientDeviceKeyId String
  wrappedKey           String // message AES key, ECDH-wrapped for this device (base64)
  wrapIv               String // IV used for the wrap (base64)

  message         DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientDevice UserDeviceKey @relation(fields: [recipientDeviceKeyId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientDeviceKeyId])
  @@index([recipientDeviceKeyId])
}

// DM v2 — one-directional user block. Enforced server-side on every DM path
// (send, typing, presence, read receipts, reactions), both directions.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("blocksMade",     fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ─── DM E2EE layer (WebAuthn-PRF passkeys + per-device envelopes) ────────────
// Key hierarchy: passkey PRF → KRK → wraps UMK → wraps device privkeys → per
// message random CK wrapped per recipient device. Server stores only public
// keys, wrapped material, ciphertext, envelopes, franking tags. All blobs are
// base64 strings (repo convention), not Prisma Bytes.

enum KeyWrapMethod {
  PASSKEY_PRF
  RECOVERY_CODE
  FALLBACK_PASSPHRASE
}

// Stored WebAuthn credential (public key + counter) for assertion verification.
// The passkey's PRF output (client-side) derives the KRK; this row only lets
// the server verify the ceremony is genuine and anti-replay the challenge.
model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique           // base64url
  publicKey    String                      // base64 COSE public key
  counter      Int      @default(0)
  transports   String?                     // CSV
  createdAt    DateTime @default(now())

  @@index([userId])
}

// One wrapped copy of the User Master Key per unlock method (passkey / recovery
// code / fallback passphrase). Adding a method = one more wrap; never re-wraps
// device keys or message history.
model UserMasterKeyWrap {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  method       KeyWrapMethod
  credentialId String?       // WebAuthn credential id (PASSKEY_PRF)
  wrappedUMK   String        // AES-GCM(KRK, UMK) base64
  wrapIv       String
  kdfSalt      String?       // RECOVERY_CODE / FALLBACK_PASSPHRASE (Argon2id)
  kdfParams    Json?
  label        String?
  createdAt    DateTime      @default(now())
  lastUsedAt   DateTime?

  @@unique([userId, credentialId])
  @@index([userId])
}

// Per-device ECDH P-256 keypair. Private key stored wrapped under the UMK so a
// freshly-unlocked device can decrypt history (envelopes target old devices).
model UserDevice {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey      String   // ECDH P-256 raw public key, base64
  wrappedPrivKey String   // AES-GCM(HKDF(UMK,"device-key-wrap"), privKey) base64
  wrapIv         String
  name           String
  revoked        Boolean  @default(false)
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  envelopes      MessageEnvelope[]

  @@index([userId, revoked])
}

// Per-recipient-device wrapped content key, with the sender's ephemeral ECDH
// public key for the unwrap.
model MessageEnvelope {
  id           String        @id @default(cuid())
  messageId    String
  message      DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  deviceId     String
  device       UserDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ephemeralPub String        // sender's ephemeral ECDH public key, base64
  wrappedCK    String        // AES-GCM(HKDF(ECDH), CK) base64
  wrapIv       String

  @@unique([messageId, deviceId])
  @@index([deviceId])
}

// DM v2 — abuse report for a conversation/message. `details` stores an
// immutable JSON snapshot of the last 50 messages so moderators can review
// even after deletion. Distinct from the posts-domain Report model.
model MessageReport {
  id             String   @id @default(cuid())
  reporterId     String
  reportedUserId String
  conversationId String
  messageId      String?
  reason         String                       // spam | harassment | nsfw | other
  details        String?  @db.Text            // JSON snapshot (immutable)
  status         String   @default("open")    // open | reviewed | actioned | dismissed
  createdAt      DateTime @default(now())

  @@index([status, createdAt])
  @@index([reportedUserId])
}

// ---------------------------------------------------------------------------
// Activity Feed (FEED_FEATURES §12 — MVP)
// ---------------------------------------------------------------------------
//
// Unified content unit for the social feed. Replaces Post going forward; Post
// table is preserved for legacy data + endpoints, but new feed reads Activity.
// Discriminator is `kind`. Most fields are nullable depending on kind:
//   - TEXT          → body required; linkedAnime/verb/episodeNumber null
//   - LIST_UPDATE   → linkedAnimeId + verb required; body optional
//   - MESSAGE       → body required; addressed to recipient via wallOwnerId
//
// Engagement counters are denormalized for fast feed rendering. Always update
// them in the same transaction as the underlying Like/Repost/Reply write.

enum ActivityKind {
  TEXT
  LIST_UPDATE
  MESSAGE
}

enum ListActivityVerb {
  WATCHED_EPISODE        // ep 12 of Frieren
  COMPLETED              // finished a series
  ADDED_TO_PLAN          // moved to plan-to-watch
  DROPPED
  RATED                  // gave a score
  STARTED                // first episode watched
  REWATCHING
}

model Activity {
  id              String          @id @default(cuid())
  authorId        String
  kind            ActivityKind
  // Text body — required for TEXT and MESSAGE kinds; optional commentary on LIST_UPDATE
  body            String?
  // List-update specifics
  linkedAnimeId   String?
  verb            ListActivityVerb?
  episodeNumber   Int?
  score           Int?            // for RATED verb (1–10)
  // Message specifics — non-null when kind=MESSAGE; recipient's profile wall
  wallOwnerId     String?
  // Spoiler scope — for client-side blur; server still ships text but the
  // recipient must opt-in to render until they've passed `spoilerScopeAnimeId`.
  hasSpoiler      Boolean         @default(false)
  // Repost chain — non-null if this activity is a repost of another
  repostOfId      String?
  // Reply parent — non-null if this activity is a top-level reply (we keep
  // Reply as a separate model for cheaper queries; this is reserved for V1
  // quote-replies / threaded conversations rooted in Activity).
  // Denormalized engagement counters
  likeCount       Int             @default(0)
  repostCount     Int             @default(0)
  replyCount      Int             @default(0)
  // Lifecycle
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  linkedAnime  Anime?            @relation(fields: [linkedAnimeId], references: [id], onDelete: SetNull)
  repostOf     Activity?         @relation("Reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts      Activity[]        @relation("Reposts")
  likes        ActivityLike[]
  repostsBy    ActivityRepost[]
  replies      Reply[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([linkedAnimeId, createdAt])
  @@index([kind, createdAt])
}

model ActivityLike {
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
  @@index([activityId])
}

// Separate from Activity.repostOfId because reposting creates BOTH a new
// Activity row (visible in feeds) AND a join row here (for "did I repost"
// checks + counter denormalization on the original).
model ActivityRepost {
  userId       String
  activityId   String   // the ORIGINAL activity being reposted
  // New Activity row produced by the repost; null only if we want to model
  // "silent" boosts later. For MVP, always populated.
  repostActivityId String? @unique
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
  @@index([activityId])
}

model Reply {
  id          String   @id @default(cuid())
  activityId  String
  authorId    String
  body        String
  hasSpoiler  Boolean  @default(false)
  // Denorm for nested reply count (V1)
  replyCount  Int      @default(0)
  likeCount   Int      @default(0)
  parentReplyId String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Reply?   @relation("ReplyParent", fields: [parentReplyId], references: [id], onDelete: SetNull)
  children Reply[]  @relation("ReplyParent")

  @@index([activityId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Admin Foundation — RBAC, Audit, Invites, TOTP, Step-up
// All additive; existing User.role enum stays as coarse end-user-app gating.
// AdminRole/Permission tables grant fine-grained admin capabilities.
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(cuid())
  resource    String   // e.g. "users", "billing", "flags"
  action      String   // e.g. "read", "suspend", "refund", "kill"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique          // SuperAdmin, Support, BillingAdmin, Moderator, ReadOnlyAdmin
  description String?
  isSystem    Boolean  @default(false)  // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserAdminRole[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserAdminRole {
  userId    String
  roleId    String
  grantedBy String?  // actorId who granted (null = system seed)
  createdAt DateTime @default(now())

  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// Append-only audit log. Writes happen exclusively through lib/audit.ts.
// Each entry's integrityHash = SHA-256(JSON.stringify({prevHash, ...entry})) —
// chained from the previous row so tampering is detectable.
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?  // userId taking the action (null = system)
  impersonatorId String?  // userId actually driving the session, if impersonation
  action         String   // e.g. "user.ban", "role.grant", "flag.kill"
  targetType     String?  // e.g. "User", "Post"
  targetId       String?
  metadata       Json?    // { before, after, reason, ... }
  ipAddress      String?
  userAgent      String?
  prevHash       String?  // integrityHash of the previous AuditLog row
  integrityHash  String   @unique
  createdAt      DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Admin-initiated invites that create new admin users (or upgrade an existing
// account to admin). Token sent via email is hashed in storage.
model UserInvite {
  id         String   @id @default(cuid())
  email      String
  tokenHash  String   @unique
  inviterId  String
  roleName   String?  // AdminRole.name to assign on accept
  expiresAt  DateTime
  acceptedAt DateTime?
  acceptedBy String?  // userId that consumed the invite
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// TOTP secret per user. Stored base32. enabled=true only after first successful
// verify. backupCodes is a JSON array of SHA-256-hashed single-use codes.
model TotpSecret {
  userId       String   @id
  secretBase32 String
  enabled      Boolean  @default(false)
  backupCodes  Json?
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Short-lived "step-up" credential issued after re-authentication. Required
// for high-risk admin actions (role grants, kill switches, DSAR delete,
// impersonation start). Stored hashed.
model StepUpToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  purpose    String   // free-form scope tag, e.g. "role.grant"
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Phase 2 — Feature flags, entitlements, impersonation
// ---------------------------------------------------------------------------

// Feature flag for runtime gating. `type` distinguishes release-vs-permission
// flags so the UI can group them. `isKillSwitch` flips the default-on flag
// off without redeploy.
model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique
  description       String?
  type              String   @default("release")  // release | experiment | ops | permission
  enabledGlobally   Boolean  @default(false)
  rolloutRules      Json?                          // { percentage?, cohorts?, tiers? }
  isKillSwitch      Boolean  @default(false)
  killedAt          DateTime?
  killedBy          String?
  killedReason      String?
  createdBy         String?
  lastEvaluatedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  overrides FeatureFlagOverride[]

  @@index([type])
}

// Per-user override that pins a flag to a value regardless of rollout rules.
// Used by support to enable/disable a feature for one account during triage.
model FeatureFlagOverride {
  id        String   @id @default(cuid())
  flagId    String
  userId    String
  enabled   Boolean
  reason    String?
  grantedBy String?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, userId])
  @@index([userId])
}

// Paid feature access. Separate from FeatureFlag — flags gate code paths;
// entitlements gate paid features. Source = "plan" for plan-derived,
// "manual" for support-granted, "trial" for time-limited grants.
model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  feature   String                  // e.g. "creator_studio", "ai_oracle"
  limit     Int?                    // null = unlimited; int = cap (e.g. 5 posts/day)
  source    String   @default("manual")
  expiresAt DateTime?
  grantedBy String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature])
  @@index([userId])
}

// Active operator-driven impersonation. The operator's real session stays
// separate; this row records the scoped session and is checked on every
// request that carries an impersonation access token.
model ImpersonationSession {
  id             String   @id @default(cuid())
  impersonatorId String
  targetUserId   String
  reason         String
  ipAddress      String?
  userAgent      String?
  startedAt      DateTime @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  endedReason    String?  // "operator_stop" | "expired" | "killed"

  @@index([impersonatorId])
  @@index([targetUserId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — API keys, webhooks, announcements, settings, shadow-ban
// ---------------------------------------------------------------------------

// Hashed API key for partner / programmatic access. The raw key is returned
// ONCE at create time and never stored. Scopes are space-separated strings.
model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique
  keyPrefix   String                       // first 8 chars of raw key — UI display
  ownerUserId String?
  scopes      String   @default("")        // "read:users write:posts" etc
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  revokedBy   String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([ownerUserId])
}

// Outbound webhook endpoint config. `events` is a JSON array of event names
// to deliver. `secret` is used to HMAC-sign payloads (raw → never returned
// in API responses after first create).
model WebhookEndpoint {
  id          String   @id @default(cuid())
  url         String
  events      Json                          // ["user.created", "post.created"]
  secret      String                        // for HMAC signing
  enabled     Boolean  @default(true)
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]
}

// One row per attempted delivery. `attempts` counts retries; `responseStatus`
// is the last HTTP code received. Replay creates a new row pointing to the
// same eventId for traceability.
model WebhookDelivery {
  id              String   @id @default(cuid())
  endpointId      String
  eventName       String
  eventId         String                   // dedupe + replay anchor
  payload         Json
  responseStatus  Int?
  responseBody    String?
  attempts        Int      @default(0)
  succeededAt     DateTime?
  lastTriedAt     DateTime?
  createdAt       DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([eventId])
}

// Platform-wide announcement. Drives in-app banners and (optionally) emails.
// `audience` examples: "all" | "admins" | "premium" | userId list (JSON).
model Announcement {
  id           String   @id @default(cuid())
  title        String
  body         String
  audience     String   @default("all")
  channel      String   @default("in_app")    // in_app | email | both
  scheduledAt  DateTime?
  publishedAt  DateTime?
  expiresAt    DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
}

// Key/value platform settings. Used for non-feature-flag config like
// brand colors, default tier limits, support email, etc.
model AdminSetting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

// Generic moderation queue. Source-agnostic: anything that needs human review
// (auto-flagged posts, spam suspects, abuse reports) becomes a row here.
// Status transitions: PENDING → APPROVED | REJECTED | REMOVED.
model ModerationItem {
  id         String   @id @default(cuid())
  targetType String              // "Post" | "PostComment" | "Club" | "User" | ...
  targetId   String
  reason     String              // why it landed in the queue
  source     String   @default("manual")  // "manual" | "auto_filter" | "user_report"
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED | REMOVED
  reviewerId String?
  reviewedAt DateTime?
  reviewNote String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// User-facing notification templates so admins don't hardcode email/in-app copy.
model NotificationTemplate {
  id          String   @id @default(cuid())
  key         String   @unique           // e.g. "welcome", "password_reset"
  channel     String                      // "email" | "in_app" | "both"
  subject     String?
  body        String                      // template string, {{var}} interpolated
  description String?
  isSystem    Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Operational alert surfaced in the admin overview. Emitted by anomaly
// detection, high-error-rate watchers, expiring-trials sweepers, etc.
model AdminAlert {
  id          String   @id @default(cuid())
  severity    String                      // "info" | "warning" | "critical"
  category    String                      // "security" | "billing" | "uptime" | "moderation"
  title       String
  body        String?
  link        String?                     // /admin/... destination
  metadata    Json?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt   DateTime @default(now())

  @@index([acknowledgedAt, createdAt])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// M5 Billing — provider-agnostic. `provider` records the source-of-truth
// system (stripe | razorpay | manual); when no provider is wired the rows
// are kept locally and can be reconciled when a provider is added later.
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(cuid())
  key               String   @unique               // "free" | "pro" | "team"
  name              String
  description       String?
  priceCents        Int      @default(0)
  currency          String   @default("USD")
  interval          String   @default("month")     // month | year | once
  trialDays         Int      @default(0)
  features          Json                            // ["creator_studio","ai_oracle"]
  isPublic          Boolean  @default(true)
  providerPriceId   String?                         // e.g. Stripe price_xxx
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  status          String   @default("ACTIVE")      // ACTIVE | TRIALING | PAST_DUE | CANCELED | PAUSED
  provider        String   @default("manual")      // stripe | razorpay | manual
  providerSubId   String?
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt     DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt      DateTime?
  pausedAt        DateTime?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([userId])
  @@index([status])
  @@index([providerSubId])
}

model Invoice {
  id               String   @id @default(cuid())
  subscriptionId   String
  amountCents      Int
  currency         String   @default("USD")
  status           String   @default("OPEN")       // OPEN | PAID | UNCOLLECTIBLE | VOID | REFUNDED
  paidAt           DateTime?
  refundedAmount   Int      @default(0)
  refundedAt       DateTime?
  refundReason     String?
  providerInvoiceId String?
  hostedInvoiceUrl String?
  failureReason    String?
  createdAt        DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([status])
}

// Audit row for every billing-provider webhook seen. Lets us replay
// reconciliation if we miss one.
model BillingEvent {
  id          String   @id @default(cuid())
  provider    String                                // stripe | razorpay
  eventType   String                                // invoice.paid | subscription.updated | ...
  eventId     String   @unique                      // provider's event id (dedupe)
  payload     Json
  processed   Boolean  @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([provider, eventType])
}

// ---------------------------------------------------------------------------
// M13 — scheduled / saved reports
// ---------------------------------------------------------------------------

model ReportSchedule {
  id          String   @id @default(cuid())
  name        String
  reportKey   String                                // identifies which report to generate
  cron        String                                // standard cron expression
  format      String   @default("csv")              // csv | json
  recipients  Json                                  // ["ops@kaiveron.com", "admin@..."]
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  lastResult  String?                               // "ok:rowcount=42" | "error:..."
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Security / inspection / moderation hardening
// ---------------------------------------------------------------------------

// Temporary IP block. Brute-force protection + admin manual ban. The
// auth middleware checks this table before processing a request.
model IpBlock {
  ip         String   @id
  reason     String                    // "bruteforce" | "manual" | "anomaly"
  blockedBy  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

// Auto-flag rule for content moderation. Posts/comments matching any
// active rule land in the moderation queue automatically.
model ContentRule {
  id          String   @id @default(cuid())
  name        String                    // human-readable
  kind        String                    // "keyword" | "regex" | "min_length" | "link_count"
  pattern     String                    // value depends on kind (the keyword, regex, threshold)
  target      String   @default("post") // "post" | "comment" | "blog" | "review"
  severity    String   @default("flag") // "flag" (queue) | "block" (refuse outright) | "shadow"
  enabled     Boolean  @default(true)
  matchCount  Int      @default(0)
  lastMatchAt DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, target])
}

// Hash of every flagged piece of content. Lets the matcher catch
// re-uses of previously-rejected text without re-running every rule.
model ContentFingerprint {
  hash        String   @id              // SHA-256 of normalized content
  targetType  String                    // "Post" | "Comment" | ...
  targetId    String
  matchedRule String?
  decision    String                    // "flag" | "removed" | "approved"
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
}

// Cached geolocation + ASN for an IP. Populated lazily by lib/geoip on
// first reference, refreshed weekly. Keeps the admin dashboard fast
// (single-row lookup) while geo data stays current enough for forensics.
model IpProfile {
  ip            String   @id
  country       String?                 // ISO-2 e.g. "US"
  countryName   String?
  region        String?
  city          String?
  latitude      Float?
  longitude     Float?
  isp           String?
  org           String?
  asn           String?
  isVpn         Boolean  @default(false)
  isProxy       Boolean  @default(false)
  isHosting     Boolean  @default(false) // datacenter / cloud IP
  lookupSource  String   @default("ip-api")
  lookupError   String?
  lastSeenAt    DateTime?               // updated whenever security events reference this IP
  refreshedAt   DateTime @default(now())

  @@index([country])
  @@index([asn])
  @@index([isVpn, isHosting])
}

// Detected anomalies. Different from AdminAlert (which is operator-facing
// notifications) — anomalies are per-user/per-IP forensic findings that
// power the /anomalies page and feed the risk score.
model AnomalyEvent {
  id            String   @id @default(cuid())
  kind          String                  // "impossible_travel" | "new_country" | "new_ip" |
                                         //   "ip_churn" | "concurrent_country" | "high_volume_signup_ip" |
                                         //   "vpn_login" | "new_device"
  severity      String   @default("info") // "info" | "warning" | "critical"
  userId        String?
  ipAddress     String?
  evidence      Json?                   // structured detail per kind
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([acknowledgedAt])
}

// ---------------------------------------------------------------------------
// Enterprise: incidents, maintenance, SLA metrics, saved replies
// ---------------------------------------------------------------------------

// Structured incident records with full lifecycle. Different from AdminAlert
// (which is a notification surface); an Incident is the THING that happens
// and gets a real post-mortem.
model Incident {
  id            String   @id @default(cuid())
  title         String
  severity      String                       // "sev1" | "sev2" | "sev3" | "sev4"
  status        String   @default("open")    // open | investigating | identified | monitoring | resolved
  category      String                       // "outage" | "degradation" | "security" | "data" | "billing"
  impactedAreas Json     @default("[]")      // ["auth","feed","search"]
  startedAt     DateTime @default(now())
  detectedAt    DateTime?                    // when ops first noticed
  resolvedAt    DateTime?
  postmortem    String?                      // markdown, written after-the-fact
  rootCause     String?                      // short summary
  openedBy      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  updates IncidentUpdate[]

  @@index([status, severity])
  @@index([startedAt])
}

// Append-only timeline of incident updates ("investigating", "identified the
// root cause", "rolled back deploy", "resolved"). Each update is itself a
// historical record.
model IncidentUpdate {
  id          String   @id @default(cuid())
  incidentId  String
  status      String                       // mirror of Incident.status at update time
  message     String                       // markdown
  authorId    String?
  createdAt   DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

// Scheduled maintenance. When `startsAt` ≤ now ≤ `endsAt`, the public
// /maintenance/current endpoint returns it; admin shell + the user-facing
// app should show a banner during the window.
model MaintenanceWindow {
  id          String   @id @default(cuid())
  title       String
  description String?
  scope       String   @default("all")     // "all" | "api" | "uploads" | "admin"
  startsAt    DateTime
  endsAt      DateTime
  cancelledAt DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt, endsAt])
}

// Rolling per-endpoint RED metrics aggregated by the SLA middleware. One row
// per (endpoint, hour) bucket — kept compact so charts stay fast.
model EndpointStat {
  id            String   @id @default(cuid())
  endpoint      String                      // "GET /api/v1/anime/:id"
  hourBucket    DateTime                    // truncated to the hour
  requests      Int      @default(0)
  errors        Int      @default(0)        // 5xx
  clientErrors  Int      @default(0)        // 4xx
  totalDurationMs BigInt @default(0)        // sum (for mean = total/requests)
  maxDurationMs Int      @default(0)
  // p50/p99 are stored as the result of in-process reservoir sampling. Not
  // exact, but good enough for an admin overview and cheap to compute.
  p50Ms         Int      @default(0)
  p99Ms         Int      @default(0)

  @@unique([endpoint, hourBucket])
  @@index([hourBucket])
  @@index([endpoint])
}

// Canned response library for support — small templates a moderator can
// drop into a reply with one click. Markdown body; {{vars}} replaced
// client-side by the operator.
model SavedReply {
  id          String   @id @default(cuid())
  title       String                       // short label shown in the picker
  body        String                       // markdown template
  category    String?                      // "billing" | "abuse" | "bug" | ...
  shortcut    String?  @unique             // e.g. "/refund" — for type-ahead pickers
  useCount    Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// PII inventory — every database column that may hold personal data, its
// classification, retention obligation, and which RBAC role is allowed to
// read it. Required for GDPR Article 30 records of processing. Auto-seeded
// from a known-field scanner; admins can override classification/retention.
model PiiField {
  id              String   @id @default(cuid())
  model           String                       // Prisma model name, e.g. "User"
  field           String                       // column name, e.g. "email"
  classification  String                       // "identifier" | "contact" | "sensitive" | "behavioral" | "device"
  legalBasis      String?                      // "consent" | "contract" | "legitimate_interest" | "legal_obligation"
  retentionDays   Int?                         // null = retain indefinitely; otherwise auto-purge by dataRetention job
  readRoleMin     String   @default("MOD")     // minimum role that may read this field directly
  description     String?                      // human note
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([model, field])
  @@index([classification])
}

// Two-person approval workflow. A subject action (delete user, transfer
// ownership, etc.) is materialized as an ApprovalRequest; the actor cannot
// approve their own request. Once approved, the original handler is allowed
// to proceed by checking ApprovalRequest.status == "approved" before
// performing the side effect.
model ApprovalRequest {
  id             String   @id @default(cuid())
  action         String                       // "users.delete" | "billing.refund" | ...
  resource       String                       // free-form: "user:abc" | "invoice:inv_123"
  payload        Json                         // serialized request body to replay on approve
  reason         String                       // why the actor requested this
  status         String   @default("pending") // pending | approved | rejected | expired | executed
  requestedBy    String                       // actor user id
  reviewedBy     String?                      // approver user id
  reviewedAt     DateTime?
  reviewNote     String?
  executedAt     DateTime?                    // when the original action actually ran post-approval
  expiresAt      DateTime                     // auto-expire after 24h by default
  createdAt      DateTime @default(now())
  decisions      ApprovalDecision[]

  @@index([status, expiresAt])
  @@index([requestedBy])
  @@index([action, status])
}

model ApprovalDecision {
  id          String   @id @default(cuid())
  requestId   String
  reviewerId  String
  decision    String                          // "approve" | "reject"
  note        String?
  createdAt   DateTime @default(now())

  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([reviewerId])
}

// Registered OAuth 2.0 client (third-party app / integration).
// Today we support client_credentials grant (app-to-app, no user context);
// authorization_code grant lands in a later batch when the consent UI is
// designed. Secret is stored as a one-way hash — admin sees plaintext only
// once at creation/rotation time.
model OauthClient {
  id              String   @id @default(cuid())
  name            String                                // human label, e.g. "Zapier"
  clientId        String   @unique                      // public identifier (prefix ka_oc_)
  clientSecretHash String                               // sha256(secret)
  type            String   @default("confidential")     // "confidential" | "public"
  scopes          String[] @default([])                 // "read:users" | "scim" | "webhooks:write" | ...
  redirectUris    String[] @default([])                 // for future authorization_code flow
  description     String?
  ownerEmail      String?                               // contact email for breach notifications
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accessTokens    OauthAccessToken[]

  @@index([revokedAt])
}

// Issued OAuth access token. Stored as a hash so a DB leak can't be used to
// forge calls. Refresh tokens are not part of client_credentials grant —
// the client just re-exchanges its secret for a new token.
model OauthAccessToken {
  id          String   @id @default(cuid())
  clientId    String                                    // FK to OauthClient.id
  tokenHash   String   @unique                          // sha256 of the bearer token
  scopes      String[] @default([])                     // granted at issuance (subset of client scopes)
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())

  client      OauthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([expiresAt])
}

// SCIM 2.0 subject mapping. An IdP (Okta, Azure AD, Google Workspace, etc.)
// addresses our users by its OWN identifier — typically a stable UUID it
// generated when the user was created in the IdP. We persist that mapping
// here rather than adding an externalId column to User, so SCIM stays an
// opt-in integration that can be removed without a User-table migration.
model ScimSubject {
  id          String   @id @default(cuid())
  externalId  String   @unique                          // IdP-provided id
  userId      String   @unique                          // local User.id (1-1)
  idpClientId String?                                   // OauthClient.id that provisioned this row
  meta        Json?                                     // raw IdP attrs we don't map (orgUnit, dept, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([idpClientId])
}

// SAML 2.0 SSO configuration. One row per IdP integration. Today we
// support a single active config (most enterprises have one IdP) — the
// `active` flag is enforced by application code, not a DB constraint, so
// we can keep historical configs around for audit.
model SamlConfig {
  id                String   @id @default(cuid())
  name              String                              // human label, e.g. "Okta Production"
  idpEntityId       String                              // urn:something from IdP metadata
  idpSsoUrl         String                              // where AuthnRequests are POSTed
  idpSloUrl         String?                             // optional single-logout endpoint
  idpCertificate    String                              // PEM-formatted X.509 (without headers ok too)
  spEntityId        String                              // our entityID — usually https://api.kaiveron.com/saml/metadata
  emailAttribute    String   @default("email")          // SAML attr name to read for the user's email
  displayNameAttr   String   @default("displayName")    // SAML attr name for the display name
  autoProvision     Boolean  @default(true)             // create new users on first login?
  active            Boolean  @default(false)            // exactly one active at a time (enforced app-side)
  signRequests      Boolean  @default(false)            // sign our AuthnRequests?
  wantAssertionsSigned Boolean @default(true)
  spPrivateKey      String?                             // PEM key for signing; null if signRequests=false
  spCertificate     String?                             // matching public cert
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active])
}

// Per-user saved filter combinations on any admin list page. Bookmarks
// a URL search-string snapshot under a friendly name.
model SavedSearch {
  id          String   @id @default(cuid())
  ownerId     String
  resource    String                                  // "users" | "tickets" | "anomalies" | ...
  name        String
  query       String                                  // raw search string snapshot
  shared      Boolean  @default(false)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, resource, name])
  @@index([resource, shared])
}

// Generic third-party integration registry.
model Integration {
  id              String   @id @default(cuid())
  provider        String                              // "datadog" | "zendesk" | ...
  name            String
  configJson      Json     @default("{}")
  secretName      String?                             // VaultEntry name for credentials
  active          Boolean  @default(true)
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  lastError       String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, name])
  @@index([provider, active])
}

// Dashboards — admin-composed layouts of widgets pulling from a safelist
// of approved data sources. The frontend grid renders each widget's
// `kind` against `source` (one of the registered keys) with `config` for
// per-widget options (axes, columns, filter).
model Dashboard {
  id          String   @id @default(cuid())
  name        String                                  // "Trust & Safety overview"
  description String?
  ownerId     String?                                 // admin user that owns this dashboard
  shared      Boolean  @default(false)                // visible to all admins when true
  layout      Json     @default("{}")                 // grid props (cols/rowHeight/etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  widgets     DashboardWidget[]

  @@index([ownerId])
  @@index([shared])
}

model DashboardWidget {
  id            String   @id @default(cuid())
  dashboardId   String
  kind          String                                // "stat" | "table" | "chart" | "text"
  source        String                                // safelisted source key, e.g. "cost.overview"
  title         String
  configJson    Json     @default("{}")               // shape varies by kind
  x             Int      @default(0)
  y             Int      @default(0)
  w             Int      @default(4)                  // columns wide (out of 12)
  h             Int      @default(3)                  // rows tall
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dashboard     Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

// Bulk exports — async export jobs for large result sets. Small exports
// (<10k rows) can stream synchronously; this table is for bigger jobs
// that need to land in object storage.
model ExportJob {
  id            String   @id @default(cuid())
  resource      String                                // "users" | "tickets" | ...
  format        String                                // "csv" | "json"
  filtersJson   Json     @default("{}")
  status        String   @default("pending")          // pending | running | completed | failed
  rowCount      Int?
  fileLocation  String?                               // s3://... after completion
  errorDetail   String?
  requestedBy   String
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
  @@index([requestedBy])
}

// Notification router. A NotificationChannel is a destination; rules
// match an event pattern + min severity and fan out to N channels.
// AdminAlert.create() goes through this pipeline so existing alert UI
// keeps working unchanged.
model NotificationChannel {
  id            String   @id @default(cuid())
  name          String                                // "Slack #ops" | "PagerDuty critical"
  kind          String                                // "email" | "slack" | "webhook" | "push"
  configJson    Json
  active        Boolean  @default(true)
  lastDeliveryAt DateTime?
  lastDeliveryStatus String?
  failCount     Int      @default(0)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rules         NotificationRuleChannel[]

  @@index([active, kind])
}

model NotificationRule {
  id            String   @id @default(cuid())
  name          String                                // "All critical alerts to #ops"
  eventPattern  String                                // "alert.critical.*" or exact "incident.created"
  minSeverity   String   @default("info")             // info | warning | critical
  active        Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  channels      NotificationRuleChannel[]

  @@index([active])
}

model NotificationRuleChannel {
  id          String   @id @default(cuid())
  ruleId      String
  channelId   String

  rule        NotificationRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel     NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([ruleId, channelId])
}

// A/B experiments — extends the FeatureFlag system. An Experiment binds a
// flag-style key to N variants with allocation weights summing to 100.
// User assignment uses sha256(userId + key) modulo 100 so it's stable —
// the same user always sees the same variant unless we change the key.
model Experiment {
  id              String   @id @default(cuid())
  key             String   @unique                    // "homepage_hero_copy"
  description     String?
  status          String   @default("draft")          // "draft" | "running" | "paused" | "completed"
  startedAt       DateTime?
  endedAt         DateTime?
  primaryMetric   String                              // "signup_completed" | "post_created" | ...
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  variants        ExperimentVariant[]
  exposures       ExperimentExposure[]

  @@index([status])
}

model ExperimentVariant {
  id             String   @id @default(cuid())
  experimentId   String
  name           String                               // "control" | "treatment" | "var_b"
  weight         Int                                  // 0..100, sums to 100 across variants
  isControl      Boolean  @default(false)
  payload        Json?                                // arbitrary per-variant config the app reads at runtime

  experiment     Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  exposures      ExperimentExposure[]

  @@unique([experimentId, name])
}

// Append-only exposure log. Captures (userId, variant, event=assigned|converted).
// Conversion is tracked by the application calling recordExposure(key, userId, "converted")
// after the primary metric fires. Results endpoint aggregates these.
model ExperimentExposure {
  id            String   @id @default(cuid())
  experimentId  String
  variantId     String
  userId        String?
  event         String                                // "assigned" | "converted"
  occurredAt    DateTime @default(now())

  experiment    Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant       ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([experimentId, event])
  @@index([userId, experimentId])
}

// On-call rotation. A schedule pins N admin users to slots that repeat
// every rotationDays. Combined with EscalationPolicy and AdminAlert, the
// "who do I page right now?" answer becomes a 1-line lookup.
model OnCallSchedule {
  id            String   @id @default(cuid())
  name          String                                // "Primary 24/7" | "DB on-call"
  timezone      String   @default("UTC")
  rotationDays  Int      @default(7)                  // length of each shift
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shifts        OnCallShift[]

  @@index([active])
}

model OnCallShift {
  id            String   @id @default(cuid())
  scheduleId    String
  userId        String                                // FK to User.id; the on-call admin
  startsAt      DateTime
  endsAt        DateTime
  notes         String?

  schedule      OnCallSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, startsAt])
  @@index([userId])
}

// Severity → channel routing. When an AdminAlert fires, we look up the
// matching policy and emit notifications via the listed channels.
model EscalationPolicy {
  id            String   @id @default(cuid())
  severity      String   @unique                      // "critical" | "warning" | "info"
  emailTo       String[] @default([])                 // emails to notify
  slackWebhookSecretName String?                      // VaultEntry name resolving to Slack webhook URL
  pushUserIds   String[] @default([])                 // admin User.ids to push-notify
  pagerOnCall   Boolean  @default(false)              // also notify the current on-call from primary schedule
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Backup tracker. Records every database/storage backup, its size, and the
// last verification status. If the dataRetention job notices a missed
// expected backup window, it raises an AdminAlert.
model BackupRecord {
  id              String   @id @default(cuid())
  kind            String                              // "db" | "uploads" | "vault"
  location        String                              // "s3://kaiveron-backups/db/2026-06-03.dump"
  sizeBytes       BigInt
  durationMs      Int?
  startedAt       DateTime
  completedAt     DateTime
  verifiedAt      DateTime?                           // null until a restore-drill verifies
  verifiedBy      String?
  retentionUntil  DateTime?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([kind, completedAt])
  @@index([verifiedAt])
}

// Per-user admin notes. Internal-only — never returned via the public
// /users/:username API. Pinned notes surface first on the user inspect view.
model UserNote {
  id          String   @id @default(cuid())
  userId      String                                  // the user the note is about
  authorId    String                                  // the admin who wrote it
  body        String
  pinned      Boolean  @default(false)
  category    String?                                 // "support" | "billing" | "safety" | "vip"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, pinned, createdAt])
  @@index([authorId])
}

// Observability — distributed trace span. Self-hosted in Postgres (good
// enough for hobby + low-mid scale; swap for OTel collector + Tempo/Jaeger
// when volume warrants). Sampled at 10% by default — controlled by
// TRACE_SAMPLE_PCT env.
//
// Note: this is intentionally a SMALL traces backend. It captures root
// request spans only; nested DB/HTTP-client spans would need a Prisma
// extension + fetch wrapper, which is a bigger lift.
model TraceSpan {
  id           String   @id @default(cuid())
  traceId      String                                  // shared across spans in one trace
  spanId       String                                  // unique to this span
  parentSpanId String?                                 // nullable for root spans
  name         String                                  // "GET /api/v1/anime/:id"
  kind         String   @default("server")             // "server" | "client" | "internal"
  status       String   @default("ok")                 // "ok" | "error"
  startedAt    DateTime
  durationMs   Int
  attributes   Json?                                   // {statusCode, ip, userId, ...}

  @@index([traceId])
  @@index([startedAt])
  @@index([name, startedAt])
}

// Observability — log entry. Pino transport writes WARN+ here so the admin
// UI can search recent errors without external log infra. Verbose levels
// stay on stdout. Pruned by dataRetention job (default 30d).
model LogEntry {
  id          String   @id @default(cuid())
  level       String                                   // "warn" | "error" | "fatal"
  message     String
  requestId   String?
  traceId     String?
  attributes  Json?                                    // arbitrary structured fields
  createdAt   DateTime @default(now())

  @@index([level, createdAt])
  @@index([traceId])
  @@index([requestId])
}

// Outbound webhook for ticket events — lets external systems (Zapier,
// n8n, Zendesk, Linear, Slack) subscribe to ticket lifecycle without us
// having to integrate with each vendor. HMAC-SHA-256 signed.
model TicketWebhook {
  id           String   @id @default(cuid())
  url          String
  events       String[] @default(["*"])                // ["ticket.created","ticket.replied","ticket.status_changed"] or ["*"]
  secret       String                                  // for HMAC sig
  active       Boolean  @default(true)
  description  String?
  lastDeliveryAt DateTime?
  lastDeliveryStatus String?                           // "ok" | "fail"
  failCount    Int      @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// Support — generic ticket. Either user-created (authenticated POST) or
// agent-created (admin opens on behalf of a user). Thread of TicketReplies
// keeps the timeline. Status transitions: open → in_progress → resolved
// (or closed without resolution). Saved replies (see SavedReply) can be
// the source of the body for fast canned replies.
model Ticket {
  id           String   @id @default(cuid())
  number       Int      @unique @default(autoincrement())   // human-friendly #1234
  subject      String
  body         String                                       // first message
  status       String   @default("open")                    // open | in_progress | resolved | closed
  priority     String   @default("normal")                  // low | normal | high | urgent
  category     String?                                      // "bug" | "billing" | "account" | ...
  userId       String?                                      // user who opened it (null when admin opens for someone else)
  email        String                                       // contact email (captured at open time)
  assigneeId   String?                                      // admin user assigned
  tags         String[] @default([])
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  replies      TicketReply[]

  @@index([status, priority, createdAt])
  @@index([assigneeId, status])
  @@index([userId])
}

model TicketReply {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String?                                       // null for system/external messages
  authorKind  String   @default("agent")                    // "agent" | "user" | "system"
  body        String
  isInternal  Boolean  @default(false)                      // internal notes hidden from end user
  createdAt   DateTime @default(now())

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// Trust — admin-managed entries for the public Trust Center page. Each
// row is a compliance certification, contact, or document. Surfaces at
// GET /api/v1/trust without auth.
model TrustCenterEntry {
  id          String   @id @default(cuid())
  kind        String                                  // "certification" | "document" | "contact" | "principle" | "audit_report"
  title       String                                  // "SOC 2 Type II"
  body        String?                                 // short markdown description
  url         String?                                 // download / link
  validUntil  DateTime?
  order       Int      @default(0)                    // display order within kind group
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, kind, order])
}

// Security — per-credential IP allowlist. Subject is an OauthClient,
// ApiKey, or User. Empty allowlist means "no restriction". Enforced by a
// new middleware that reads this table.
model IpAllowlistEntry {
  id           String   @id @default(cuid())
  subjectType  String                                  // "api_key" | "oauth_client" | "user"
  subjectId    String
  cidr         String                                  // "203.0.113.0/24" or "203.0.113.42/32"
  description  String?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([subjectType, subjectId])
}

// Security — abstracted secrets vault. Generalizes the existing ApiKey
// pattern so things like "Stripe webhook signing secret" or "OpenAI key"
// can be admin-managed. Secrets stored as AES-256-GCM ciphertext using
// the app's master key (env). For new secrets we use AWS KMS in production;
// here we only persist the ciphertext + meta — the actual decryption helper
// lives in lib/vault.ts (which doesn't ship plaintext over the wire).
model VaultEntry {
  id           String   @id @default(cuid())
  name         String   @unique                       // "stripe.webhook_secret"
  category     String                                  // "payments" | "ai" | "comms" | "infra"
  ciphertextB64 String                                 // AES-256-GCM ciphertext, base64
  ivB64        String                                  // 12-byte IV, base64
  authTagB64   String                                  // 16-byte auth tag, base64
  rotationDueAt DateTime?
  rotatedAt    DateTime?
  rotatedBy    String?
  lastReadAt   DateTime?                               // bumped on each readSecret()
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

// Security — disaster recovery runbooks. Markdown body, severity, expected
// duration. Surfaces alongside incidents during sev1/sev2 so the on-call
// has the playbook one click away.
model DrRunbook {
  id              String   @id @default(cuid())
  title           String
  triggerCategory String                              // matches Incident.category
  severity        String                              // "sev1" | "sev2" | "sev3"
  body            String                              // markdown
  expectedDurationMinutes Int?
  ownerEmail      String?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([triggerCategory, severity])
}

// Observability — SLO definition. Computes error-budget burn against the
// EndpointStat table. Single objective per endpoint today; multi-objective
// (e.g. p99 latency AND error rate combined) in a later batch.
model SloDefinition {
  id              String   @id @default(cuid())
  name            String                              // "API availability — anime catalogue"
  endpoint        String                              // "GET /api/v1/anime/:id" or "*" for all
  objectiveType   String                              // "availability" | "latency_p99"
  targetPct       Float                               // e.g. 99.9 means 99.9% requests succeed / under p99 threshold
  windowDays      Int      @default(30)               // rolling window
  thresholdMs     Int?                                // required when objectiveType = latency_p99
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([endpoint])
}

// Observability — synthetic monitor SCHEDULE. We persist the schedule + last
// outcome, but the runner itself is intentionally out of scope (needs a
// separate worker we don't run in-process). Admins can record manual probes
// via /admin/observability/monitors/:id/record.
model SyntheticMonitor {
  id              String   @id @default(cuid())
  name            String                              // "Login flow"
  url             String                              // probe URL
  method          String   @default("GET")
  expectedStatus  Int      @default(200)
  expectedBodyContains String?                        // substring assertion (optional)
  intervalSeconds Int      @default(300)              // how often it SHOULD run
  enabled         Boolean  @default(true)
  lastRunAt       DateTime?
  lastOutcome     String?                             // "ok" | "fail" | "timeout"
  lastLatencyMs   Int?
  lastError       String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// AI ops — per-call log of LLM inference requests. Populated by the existing
// aiRouter wrappers; populates the cost dashboard and the latency trend chart.
model LlmCall {
  id              String   @id @default(cuid())
  provider        String                              // "openai" | "anthropic" | "gateway"
  model           String                              // "gpt-4o-mini" | "claude-sonnet-4-6" | ...
  endpoint        String?                             // "/ai/discover" | "/ai/recommend"
  userId          String?
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  costCents       Int      @default(0)                // 1/100ths of a cent (consistent with CostRate)
  latencyMs       Int      @default(0)
  status          String   @default("ok")             // "ok" | "error" | "timeout" | "filtered"
  errorDetail     String?
  promptVersionId String?                             // optional FK to PromptVersion
  createdAt       DateTime @default(now())

  @@index([provider, createdAt])
  @@index([userId, createdAt])
  @@index([endpoint, createdAt])
  @@index([status])
}

// AI ops — prompt registry with versioning. Lets a non-engineer iterate
// on a prompt, ship a new version, A/B between them.
model PromptVersion {
  id              String   @id @default(cuid())
  key             String                              // logical name like "anime_recommender"
  version         Int                                 // monotonic per key
  template        String                              // markdown template; {{vars}} substituted in code
  description     String?
  active          Boolean  @default(false)            // exactly one active per key (app-side enforced)
  metricsJson     Json?                               // snapshot of eval scores at activation
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([key, version])
  @@index([key, active])
}

// AI ops — eval results from regression test runs. Aggregated per
// (promptVersion, evalSet) so the dashboard shows trends across versions.
model EvalResult {
  id              String   @id @default(cuid())
  promptVersionId String
  evalSet         String                              // "regression_v1" | "safety_v2"
  scoreOverall    Float
  scoresJson      Json                                // per-criterion breakdown
  sampleCount     Int
  ranAt           DateTime @default(now())
  ranBy           String?

  @@index([promptVersionId])
  @@index([evalSet, ranAt])
}

// AI ops — RAG document inventory. Each row is a document indexed for
// retrieval; size + chunk count surface in the dashboard so admins know
// what the model is grounded on.
model RagDocument {
  id              String   @id @default(cuid())
  collection      String                              // "anime_facts" | "help_articles"
  title           String
  sourceUrl       String?
  contentHash     String                              // sha256 of source — for change detection
  chunks          Int      @default(0)
  bytes           Int      @default(0)
  lastIndexedAt   DateTime @default(now())
  active          Boolean  @default(true)
  metadata        Json?

  @@unique([collection, contentHash])
  @@index([collection, active])
}

// Compliance — per-user consent record (GDPR Article 7 + EU AI Act).
// One row per (userId, purpose). Created on consent given, updated on
// withdrawal — `withdrawnAt` set rather than row deleted so the audit
// trail is preserved.
model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  purpose     String                                   // "marketing_email" | "personalization" | "third_party_analytics" | "ai_training" | ...
  version     String                                   // copy of the consent text version
  givenAt     DateTime @default(now())
  withdrawnAt DateTime?
  ipAddress   String?
  userAgent   String?
  source      String   @default("ui")                  // "ui" | "imported" | "scim" | "saml"
  metadata    Json?

  @@unique([userId, purpose])
  @@index([userId])
  @@index([purpose])
}

// Compliance — Right-To-Be-Forgotten request queue (GDPR Article 17).
// Separate from DSAR (data export). A request goes through:
//   pending → verified → executing → completed | rejected
// Verification = email link the requester must click (proof of identity).
// Execution = hard purge of personal data, leaving anonymized rows so the
// audit hash chain isn't broken.
model RtbfRequest {
  id           String   @id @default(cuid())
  userId       String
  email        String                                  // captured at request time in case user is later anonymized
  status       String   @default("pending")            // pending | verified | executing | completed | rejected
  verificationTokenHash String?                        // sha256; null after verification
  verifiedAt   DateTime?
  rejectedReason String?
  executedAt   DateTime?
  executorId   String?                                 // admin who pressed execute
  retentionExceptionsJson Json?                        // legal-hold items that survive the purge
  requestedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([userId])
}

// Compliance — sub-processor / vendor register (GDPR Article 30 §2 +
// SOC2 vendor management). Admin-managed list of every third party that
// touches user data, what they do with it, and the contract.
model VendorRecord {
  id              String   @id @default(cuid())
  name            String                               // "OpenAI"
  url             String                               // homepage / privacy URL
  category        String                               // "ai_model" | "email" | "monitoring" | "infra" | "support" | ...
  dataAccessed    String[] @default([])                // ["email","posts","ip"]
  region          String?                              // "us-east-1" | "eu-west-1"
  dpaUrl          String?                              // signed DPA link
  contactEmail    String?
  notes           String?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
}

// Compliance — KMS / encryption-at-rest key rotation tracker. We don't
// actually rotate keys here (the cloud KMS does) — we record when it
// happened, who reviewed, and the next-due date so an SOC2 auditor can
// see we're managing rotation policy.
model KmsKeyRotation {
  id            String   @id @default(cuid())
  keyAlias      String                                 // "rds-master" | "uploads-bucket" | ...
  provider      String                                 // "aws_kms" | "gcp_kms" | "vault"
  algorithm     String?                                // "AES-256" | "RSA-2048"
  lastRotatedAt DateTime
  nextDueAt     DateTime                               // policy says rotate before this
  rotatedBy     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([keyAlias])
  @@index([nextDueAt])
}

// DX — per-subject rate-limit override. Subject is either an ApiKey id or
// an OauthClient id. Applied at request time by the rate-limit middleware
// when present, replacing the default global limit.
model RateLimitOverride {
  id           String   @id @default(cuid())
  subjectType  String                                  // "api_key" | "oauth_client"
  subjectId    String                                  // FK to the appropriate table (no DB-side FK)
  requestsPerWindow Int                                // total requests
  windowSeconds Int                                    // window length
  reason       String?                                 // why this override exists
  expiresAt    DateTime?                               // null = never; auto-applied/expired by middleware
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([subjectType, subjectId])
  @@index([expiresAt])
}

// DX — admin-managed changelog visible at /api/v1/changelog (public) and
// the admin UI. Used for breaking-change announcements + deprecation notices.
model ApiChangeLog {
  id          String   @id @default(cuid())
  publishedAt DateTime @default(now())                 // when the change went live
  changeType  String                                   // "breaking" | "feature" | "fix" | "deprecation" | "security"
  title       String
  body        String                                   // markdown
  affects     String[] @default([])                    // ["GET /api/v1/anime/:id", "POST /webhooks"]
  authorId    String?
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([changeType])
}

// DX — endpoint deprecation tracker. Causes the SLA middleware to emit a
// Sunset + Deprecation header automatically; surfaces in the docs UI with
// a strikethrough or banner.
model DeprecatedEndpoint {
  id           String   @id @default(cuid())
  endpoint     String   @unique                        // "GET /api/v1/anime/:id"
  deprecatedAt DateTime @default(now())
  sunsetAt     DateTime                                // when the endpoint will be removed
  reason       String?
  replacement  String?                                 // "GET /api/v2/anime/:id"
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([sunsetAt])
}

// DX — request replay. Captures the raw request body + headers for a small
// allowed set of routes so debug-mode can re-issue them. Persisted across
// restarts; pruned by the dataRetention job.
model RequestCapture {
  id          String   @id @default(cuid())
  endpoint    String                                   // "POST /webhooks/foo"
  method      String
  path        String
  headersJson Json
  bodyJson    Json?
  bodyText    String?
  statusCode  Int?
  responseMs  Int?
  capturedBy  String?                                  // userId that triggered the capture
  createdAt   DateTime @default(now())

  @@index([endpoint, createdAt])
  @@index([createdAt])
}

// FinOps — per-endpoint cost rate. Admins fill in cents-per-1k-requests
// based on infra observation; cost dashboard multiplies request volume
// from EndpointStat by these rates. Default: 0 (free) when no rate set.
model CostRate {
  id              String   @id @default(cuid())
  endpoint        String   @unique                 // "GET /api/v1/anime/:id" — must match EndpointStat.endpoint
  centsPer1k      Int      @default(0)             // cost of 1000 requests, in 1/100ths of a cent (so 1 = $0.0001)
  notes           String?
  category        String?                          // "db_heavy" | "ai" | "cache_hit" | etc — for grouping
  updatedBy       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// Monthly spend budget. Crossing the threshold raises an AdminAlert and
// (later) can trigger throttling. Single row per scope ("global" today;
// per-endpoint in a later batch).
model CostBudget {
  id              String   @id @default(cuid())
  scope           String   @unique                 // "global" today; "endpoint:GET /x" later
  monthlyBudgetCents BigInt                        // total budget in 1/100ths of a cent (kept consistent w/ CostRate)
  alertAtPct      Int      @default(80)            // raise warn alert at this % of budget
  hardCapAtPct    Int?                             // null = no hard cap (no enforcement today; placeholder)
  lastAlertAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Audit trail for SSO logins — useful for "did SSO actually work last week?"
// and for compliance reports. Distinct from SecurityEvent which covers
// password/OAuth logins.
model SamlLoginEvent {
  id          String   @id @default(cuid())
  configId    String                                    // FK to SamlConfig.id (no constraint — config can be deleted)
  userId      String?                                   // null if provisioning was rejected
  email       String?                                   // raw email from SAML
  outcome     String                                    // "success" | "rejected_provision" | "verification_failed" | "expired_assertion"
  ipAddress   String?
  userAgent   String?
  errorDetail String?
  createdAt   DateTime @default(now())

  @@index([configId, createdAt])
  @@index([userId])
}


// ─── Shots — short vertical videos (reels) ──────────────────────────────────
// Mirrors the Post/PostLike pattern: soft-delete, cursor feed on createdAt,
// composite-PK likes. Video bytes live in object storage (presigned PUT, same
// flow as post images) — only URLs are stored here.

model Shot {
  id           String    @id @default(cuid())
  authorId     String
  caption      String?
  videoUrl     String
  thumbnailUrl String?
  durationMs   Int?
  animeId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  anime  Anime?     @relation(fields: [animeId], references: [id], onDelete: SetNull)
  likes  ShotLike[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([animeId])
}

model ShotLike {
  userId String
  shotId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shot Shot @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@id([userId, shotId])
}

// ─── Social connections — link external accounts (Instagram) ────────────────
// Lets creators connect Instagram and import Reels straight into Shots. The
// access token is long-lived; refresh it before expiry. One row per provider.

model SocialConnection {
  id             String    @id @default(cuid())
  userId         String
  provider       String    // "instagram"
  providerUserId String    // external account id (IG user id)
  username       String?   // external handle, for display
  accessToken    String    // long-lived token (treat as a secret)
  tokenExpiresAt DateTime?
  scopes         String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// One row per imported external media item, so re-importing is idempotent and
// the UI can show "already imported". Links to the resulting Shot when created.

model ImportedMedia {
  id         String   @id @default(cuid())
  userId     String
  provider   String   // "instagram"
  externalId String   // provider media id
  shotId     String?  // resulting Shot, if imported
  permalink  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
  @@index([userId])
}


// ─── Peeak — 24-hour stories ────────────────────────────────────────────────
// Ephemeral media shown in the Messages-screen rail. Soft-deleted + expiry
// filtered in queries; a cleanup job can hard-delete later. Views power the
// seen/unseen ring state per viewer.

model Story {
  id        String    @id @default(cuid())
  authorId  String
  mediaUrl  String
  mediaType String    // "image" | "video"
  caption   String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  deletedAt DateTime?

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

model StoryView {
  userId   String
  storyId  String
  viewedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
}
