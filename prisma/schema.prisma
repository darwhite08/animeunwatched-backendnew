generator client {
  provider = "prisma-client"
  output   = "../app/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  MOD
  ADMIN
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
  REWATCHING   // Most-requested missing status (research finding)
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Auth & Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  /// URL-safe slug for human-readable routing. Derived from displayName at registration.
  /// Never used for data access — only for URL display. Always look up session userId internally.
  /// Nullable so existing users can be backfilled without data loss.
  slug         String?  @unique
  displayName  String
  bio          String?
  avatarUrl    String?
  passwordHash String  @default("")
  role         Role     @default(USER)
  reputation   Int      @default(0)
  isBanned     Boolean  @default(false)
  bannedReason String?  // operator-supplied reason shown in admin tooling, null when not banned
  isShadowBanned Boolean @default(false)  // soft moderation: user can post but content is hidden from others
  // Streak tracking — real database-backed (not rep estimate)
  streakDays   Int      @default(0)
  lastActiveAt DateTime?
  bestStreak   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])

  refreshTokens      RefreshToken[]
  following          Follow[]           @relation("Follower")
  followers          Follow[]           @relation("Following")
  listEntries        ListEntry[]
  posts              Post[]
  postLikes          PostLike[]
  postComments       PostComment[]
  postCommentLikes   PostCommentLike[]
  ownedClubs         Club[]             @relation("ClubOwner")
  clubMemberships    ClubMember[]
  threads            Thread[]
  threadReplies      ThreadReply[]
  reviews            Review[]
  reviewLikes        ReviewLike[]
  blogs              Blog[]
  blogComments       BlogComment[]
  notifications      Notification[]
  reports            Report[]           @relation("Reporter")
  moderationActions  ModerationAction[]
  polls              Poll[]
  pollVotes          PollVote[]
  // OAuth providers linked to this account
  oauthProviders     UserOAuthProvider[]
  passwordResetTokens PasswordResetToken[]
  securityEvents      SecurityEvent[]
  // Chat
  publicKey          UserPublicKey?
  sentMessages       DirectMessage[]    @relation("MessageSender")
  conversations1     Conversation[]     @relation("ConvParticipant1")
  conversations2     Conversation[]     @relation("ConvParticipant2")
  // Push notification device tokens
  deviceTokens       DeviceToken[]
  // Activity feed (FEED_FEATURES §12 — MVP)
  activities         Activity[]
  activityLikes      ActivityLike[]
  activityReposts    ActivityRepost[]
  replies            Reply[]
  // SCIM 2.0 provisioning mapping (optional — only populated if an IdP provisioned this user)
  scimSubject        ScimSubject?
}

// One row per registered push-notification device for a user.
// A user can have many (phone + tablet + work device, etc.).
// Token uniqueness across users: a given Expo push token belongs to ONE device,
// so if it's seen on a new userId we transfer ownership rather than duplicate.
model DeviceToken {
  id          String   @id @default(cuid())
  userId      String
  expoToken   String   @unique
  platform    String   // "ios" | "android" | "web"
  deviceName  String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  // Session metadata — populated on issuance for the "active sessions" UI
  userAgent String?
  ipAddress String?
  lastUsedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // for the cleanup cron job
}

// Single-use password reset token. Created on POST /auth/forgot-password,
// consumed on POST /auth/reset-password. Hashed in storage to prevent
// DB-level token theft from being directly usable.
model PasswordResetToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique  // SHA-256 of the actual token sent to the user
  userId     String
  expiresAt  DateTime           // 1 hour from creation
  consumedAt DateTime?           // set on successful reset
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Append-only audit log for security-relevant events.
// type values: "login_success" | "login_failed" | "password_changed" |
//              "password_reset_requested" | "password_reset_completed" |
//              "account_deleted" | "session_revoked" | "logout_all"
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ---------------------------------------------------------------------------
// Anime catalog
// ---------------------------------------------------------------------------

model Anime {
  id             String    @id @default(cuid())
  malId          Int       @unique
  title          String
  titleEnglish   String?
  titleJapanese  String?
  synopsis       String?
  type           String?
  episodes       Int?
  status         String?
  airedFrom      DateTime?
  airedTo        DateTime?
  season         String?
  year           Int?
  rating         String?
  score          Float?
  imageUrl       String?
  trailerUrl     String?
  source         String?
  updatedAt      DateTime  @updatedAt

  genres      AnimeGenre[]
  studios     AnimeStudio[]
  listEntries ListEntry[]
  posts       Post[]
  threads     Thread[]
  reviews     Review[]
  activities  Activity[]

  @@index([malId])
  @@index([score])
}

model Genre {
  id   String @id @default(cuid())
  name String @unique

  animes AnimeGenre[]
}

model Studio {
  id   String @id @default(cuid())
  name String @unique

  animes AnimeStudio[]
}

model AnimeGenre {
  animeId String
  genreId String

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([animeId, genreId])
}

model AnimeStudio {
  animeId  String
  studioId String

  anime  Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([animeId, studioId])
}

// ---------------------------------------------------------------------------
// User watch list
// ---------------------------------------------------------------------------

model ListEntry {
  id           String      @id @default(cuid())
  userId       String
  animeId      String
  status       WatchStatus
  score        Int?
  episodesSeen Int         @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Posts (Twitter-style feed)
// ---------------------------------------------------------------------------

model Post {
  id        String    @id @default(cuid())
  authorId  String
  content   String
  animeId   String?
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  anime    Anime?        @relation(fields: [animeId], references: [id], onDelete: SetNull)
  likes    PostLike[]
  comments PostComment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([animeId])
}

model PostLike {
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostComment {
  id              String   @id @default(cuid())
  postId          String
  authorId        String
  content         String
  // Self-recursive parent → builds nested reply chains ("thread strings").
  parentCommentId String?
  // Denormalized engagement counters (always updated in the same transaction
  // as the underlying like / reply write).
  likeCount       Int      @default(0)
  replyCount      Int      @default(0)
  createdAt       DateTime @default(now())

  post   Post          @relation(fields: [postId],          references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId],        references: [id], onDelete: Cascade)
  parent PostComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")
  likes  PostCommentLike[]

  @@index([postId, parentCommentId, createdAt])
  @@index([parentCommentId, createdAt])
}

model PostCommentLike {
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId],    references: [id], onDelete: Cascade)
  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

// ---------------------------------------------------------------------------
// Clubs
// ---------------------------------------------------------------------------

model Club {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  ownerId     String
  reputation  Int      @default(0)
  createdAt   DateTime @default(now())

  owner   User         @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members ClubMember[]
  threads Thread[]

  @@index([slug])
  @@index([createdAt])
  @@index([reputation, createdAt])
}

model ClubMember {
  userId   String
  clubId   String
  role     Role     @default(USER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
  @@index([clubId])
}

// ---------------------------------------------------------------------------
// Threads (Reddit-style discussion)
// ---------------------------------------------------------------------------

model Thread {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  clubId    String?
  animeId   String?
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  club    Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  anime   Anime?        @relation(fields: [animeId], references: [id], onDelete: SetNull)
  replies ThreadReply[]

  @@index([clubId, createdAt])
  @@index([animeId, createdAt])
  @@index([authorId])
}

model ThreadReply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  thread Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent ThreadReply? @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: SetNull)
  children ThreadReply[] @relation("ReplyToReply")

  @@index([threadId, createdAt])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id          String   @id @default(cuid())
  animeId     String
  authorId    String
  score       Int
  body        String
  hasSpoilers Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anime  Anime        @relation(fields: [animeId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes  ReviewLike[]

  @@unique([animeId, authorId])
  @@index([animeId, createdAt])
  @@index([authorId])
}

model ReviewLike {
  userId   String
  reviewId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

// ---------------------------------------------------------------------------
// Blogs
// ---------------------------------------------------------------------------

model Blog {
  id          String     @id @default(cuid())
  slug        String     @unique
  authorId    String
  title       String
  body        String
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments BlogComment[]

  @@index([authorId])
  @@index([status, publishedAt])
}

model BlogComment {
  id        String   @id @default(cuid())
  blogId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([blogId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  type        String
  payload     Json
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, read])
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetType, targetId])
}

model ModerationAction {
  id         String   @id @default(cuid())
  modId      String
  targetType String
  targetId   String
  action     String
  note       String?
  createdAt  DateTime @default(now())

  mod User @relation(fields: [modId], references: [id], onDelete: Cascade)

  @@index([modId])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Polls
// ---------------------------------------------------------------------------

model Poll {
  id        String   @id @default(cuid())
  question  String
  authorId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  author  User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([authorId])
  @@index([expiresAt])
}

model PollOption {
  id      String @id @default(cuid())
  pollId  String
  label   String
  order   Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  userId   String
  pollId   String
  optionId String

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([userId, pollId])
  @@index([pollId])
}

// ---------------------------------------------------------------------------
// OAuth providers
// ---------------------------------------------------------------------------

// One row per OAuth provider linked to a user account.
// Allows the same email to sign in via Google AND Apple without conflict.
model UserOAuthProvider {
  id         String   @id @default(cuid())
  userId     String
  provider   String   // "google" | "apple"
  providerId String   // Provider's stable user ID (sub claim)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Direct Messages — E2E Encrypted Chat
// ---------------------------------------------------------------------------

// Each user's ECDH P-256 public key (JWK JSON string).
// The private key never leaves the client.
model UserPublicKey {
  userId    String   @id
  publicKey String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A conversation between exactly two users.
// participant1 is always the lexicographically smaller userId to enforce uniqueness.
model Conversation {
  id           String   @id @default(cuid())
  participant1 String
  participant2 String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user1    User            @relation("ConvParticipant1", fields: [participant1], references: [id], onDelete: Cascade)
  user2    User            @relation("ConvParticipant2", fields: [participant2], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([participant1, participant2])
  @@index([participant1])
  @@index([participant2])
}

// A single encrypted message. The server stores ciphertext only — it cannot
// read the message content. Clients decrypt using their ECDH-derived shared secret.
model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  ciphertext     String    // AES-GCM encrypted content, base64
  iv             String    // AES-GCM IV, base64
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  // WhatsApp-style deletion model:
  // - deletedAt: set when sender uses "Delete for everyone" (within 24h);
  //   ciphertext is cleared and clients render a tombstone for both users.
  // - deletedForSender / deletedForRecipient: "Delete for me" — message is
  //   hidden from that side's view but the other side still sees it.
  deletedAt             DateTime?
  deletedForSender      Boolean   @default(false)
  deletedForRecipient   Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Activity Feed (FEED_FEATURES §12 — MVP)
// ---------------------------------------------------------------------------
//
// Unified content unit for the social feed. Replaces Post going forward; Post
// table is preserved for legacy data + endpoints, but new feed reads Activity.
// Discriminator is `kind`. Most fields are nullable depending on kind:
//   - TEXT          → body required; linkedAnime/verb/episodeNumber null
//   - LIST_UPDATE   → linkedAnimeId + verb required; body optional
//   - MESSAGE       → body required; addressed to recipient via wallOwnerId
//
// Engagement counters are denormalized for fast feed rendering. Always update
// them in the same transaction as the underlying Like/Repost/Reply write.

enum ActivityKind {
  TEXT
  LIST_UPDATE
  MESSAGE
}

enum ListActivityVerb {
  WATCHED_EPISODE        // ep 12 of Frieren
  COMPLETED              // finished a series
  ADDED_TO_PLAN          // moved to plan-to-watch
  DROPPED
  RATED                  // gave a score
  STARTED                // first episode watched
  REWATCHING
}

model Activity {
  id              String          @id @default(cuid())
  authorId        String
  kind            ActivityKind
  // Text body — required for TEXT and MESSAGE kinds; optional commentary on LIST_UPDATE
  body            String?
  // List-update specifics
  linkedAnimeId   String?
  verb            ListActivityVerb?
  episodeNumber   Int?
  score           Int?            // for RATED verb (1–10)
  // Message specifics — non-null when kind=MESSAGE; recipient's profile wall
  wallOwnerId     String?
  // Spoiler scope — for client-side blur; server still ships text but the
  // recipient must opt-in to render until they've passed `spoilerScopeAnimeId`.
  hasSpoiler      Boolean         @default(false)
  // Repost chain — non-null if this activity is a repost of another
  repostOfId      String?
  // Reply parent — non-null if this activity is a top-level reply (we keep
  // Reply as a separate model for cheaper queries; this is reserved for V1
  // quote-replies / threaded conversations rooted in Activity).
  // Denormalized engagement counters
  likeCount       Int             @default(0)
  repostCount     Int             @default(0)
  replyCount      Int             @default(0)
  // Lifecycle
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  linkedAnime  Anime?            @relation(fields: [linkedAnimeId], references: [id], onDelete: SetNull)
  repostOf     Activity?         @relation("Reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts      Activity[]        @relation("Reposts")
  likes        ActivityLike[]
  repostsBy    ActivityRepost[]
  replies      Reply[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([linkedAnimeId, createdAt])
  @@index([kind, createdAt])
}

model ActivityLike {
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
  @@index([activityId])
}

// Separate from Activity.repostOfId because reposting creates BOTH a new
// Activity row (visible in feeds) AND a join row here (for "did I repost"
// checks + counter denormalization on the original).
model ActivityRepost {
  userId       String
  activityId   String   // the ORIGINAL activity being reposted
  // New Activity row produced by the repost; null only if we want to model
  // "silent" boosts later. For MVP, always populated.
  repostActivityId String? @unique
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
  @@index([activityId])
}

model Reply {
  id          String   @id @default(cuid())
  activityId  String
  authorId    String
  body        String
  hasSpoiler  Boolean  @default(false)
  // Denorm for nested reply count (V1)
  replyCount  Int      @default(0)
  likeCount   Int      @default(0)
  parentReplyId String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Reply?   @relation("ReplyParent", fields: [parentReplyId], references: [id], onDelete: SetNull)
  children Reply[]  @relation("ReplyParent")

  @@index([activityId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Admin Foundation — RBAC, Audit, Invites, TOTP, Step-up
// All additive; existing User.role enum stays as coarse end-user-app gating.
// AdminRole/Permission tables grant fine-grained admin capabilities.
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(cuid())
  resource    String   // e.g. "users", "billing", "flags"
  action      String   // e.g. "read", "suspend", "refund", "kill"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique          // SuperAdmin, Support, BillingAdmin, Moderator, ReadOnlyAdmin
  description String?
  isSystem    Boolean  @default(false)  // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserAdminRole[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserAdminRole {
  userId    String
  roleId    String
  grantedBy String?  // actorId who granted (null = system seed)
  createdAt DateTime @default(now())

  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// Append-only audit log. Writes happen exclusively through lib/audit.ts.
// Each entry's integrityHash = SHA-256(JSON.stringify({prevHash, ...entry})) —
// chained from the previous row so tampering is detectable.
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?  // userId taking the action (null = system)
  impersonatorId String?  // userId actually driving the session, if impersonation
  action         String   // e.g. "user.ban", "role.grant", "flag.kill"
  targetType     String?  // e.g. "User", "Post"
  targetId       String?
  metadata       Json?    // { before, after, reason, ... }
  ipAddress      String?
  userAgent      String?
  prevHash       String?  // integrityHash of the previous AuditLog row
  integrityHash  String   @unique
  createdAt      DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Admin-initiated invites that create new admin users (or upgrade an existing
// account to admin). Token sent via email is hashed in storage.
model UserInvite {
  id         String   @id @default(cuid())
  email      String
  tokenHash  String   @unique
  inviterId  String
  roleName   String?  // AdminRole.name to assign on accept
  expiresAt  DateTime
  acceptedAt DateTime?
  acceptedBy String?  // userId that consumed the invite
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// TOTP secret per user. Stored base32. enabled=true only after first successful
// verify. backupCodes is a JSON array of SHA-256-hashed single-use codes.
model TotpSecret {
  userId       String   @id
  secretBase32 String
  enabled      Boolean  @default(false)
  backupCodes  Json?
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Short-lived "step-up" credential issued after re-authentication. Required
// for high-risk admin actions (role grants, kill switches, DSAR delete,
// impersonation start). Stored hashed.
model StepUpToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  purpose    String   // free-form scope tag, e.g. "role.grant"
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Phase 2 — Feature flags, entitlements, impersonation
// ---------------------------------------------------------------------------

// Feature flag for runtime gating. `type` distinguishes release-vs-permission
// flags so the UI can group them. `isKillSwitch` flips the default-on flag
// off without redeploy.
model FeatureFlag {
  id                String   @id @default(cuid())
  key               String   @unique
  description       String?
  type              String   @default("release")  // release | experiment | ops | permission
  enabledGlobally   Boolean  @default(false)
  rolloutRules      Json?                          // { percentage?, cohorts?, tiers? }
  isKillSwitch      Boolean  @default(false)
  killedAt          DateTime?
  killedBy          String?
  killedReason      String?
  createdBy         String?
  lastEvaluatedAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  overrides FeatureFlagOverride[]

  @@index([type])
}

// Per-user override that pins a flag to a value regardless of rollout rules.
// Used by support to enable/disable a feature for one account during triage.
model FeatureFlagOverride {
  id        String   @id @default(cuid())
  flagId    String
  userId    String
  enabled   Boolean
  reason    String?
  grantedBy String?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, userId])
  @@index([userId])
}

// Paid feature access. Separate from FeatureFlag — flags gate code paths;
// entitlements gate paid features. Source = "plan" for plan-derived,
// "manual" for support-granted, "trial" for time-limited grants.
model Entitlement {
  id        String   @id @default(cuid())
  userId    String
  feature   String                  // e.g. "creator_studio", "ai_oracle"
  limit     Int?                    // null = unlimited; int = cap (e.g. 5 posts/day)
  source    String   @default("manual")
  expiresAt DateTime?
  grantedBy String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature])
  @@index([userId])
}

// Active operator-driven impersonation. The operator's real session stays
// separate; this row records the scoped session and is checked on every
// request that carries an impersonation access token.
model ImpersonationSession {
  id             String   @id @default(cuid())
  impersonatorId String
  targetUserId   String
  reason         String
  ipAddress      String?
  userAgent      String?
  startedAt      DateTime @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  endedReason    String?  // "operator_stop" | "expired" | "killed"

  @@index([impersonatorId])
  @@index([targetUserId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — API keys, webhooks, announcements, settings, shadow-ban
// ---------------------------------------------------------------------------

// Hashed API key for partner / programmatic access. The raw key is returned
// ONCE at create time and never stored. Scopes are space-separated strings.
model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique
  keyPrefix   String                       // first 8 chars of raw key — UI display
  ownerUserId String?
  scopes      String   @default("")        // "read:users write:posts" etc
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  revokedBy   String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([ownerUserId])
}

// Outbound webhook endpoint config. `events` is a JSON array of event names
// to deliver. `secret` is used to HMAC-sign payloads (raw → never returned
// in API responses after first create).
model WebhookEndpoint {
  id          String   @id @default(cuid())
  url         String
  events      Json                          // ["user.created", "post.created"]
  secret      String                        // for HMAC signing
  enabled     Boolean  @default(true)
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]
}

// One row per attempted delivery. `attempts` counts retries; `responseStatus`
// is the last HTTP code received. Replay creates a new row pointing to the
// same eventId for traceability.
model WebhookDelivery {
  id              String   @id @default(cuid())
  endpointId      String
  eventName       String
  eventId         String                   // dedupe + replay anchor
  payload         Json
  responseStatus  Int?
  responseBody    String?
  attempts        Int      @default(0)
  succeededAt     DateTime?
  lastTriedAt     DateTime?
  createdAt       DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([eventId])
}

// Platform-wide announcement. Drives in-app banners and (optionally) emails.
// `audience` examples: "all" | "admins" | "premium" | userId list (JSON).
model Announcement {
  id           String   @id @default(cuid())
  title        String
  body         String
  audience     String   @default("all")
  channel      String   @default("in_app")    // in_app | email | both
  scheduledAt  DateTime?
  publishedAt  DateTime?
  expiresAt    DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
}

// Key/value platform settings. Used for non-feature-flag config like
// brand colors, default tier limits, support email, etc.
model AdminSetting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

// Generic moderation queue. Source-agnostic: anything that needs human review
// (auto-flagged posts, spam suspects, abuse reports) becomes a row here.
// Status transitions: PENDING → APPROVED | REJECTED | REMOVED.
model ModerationItem {
  id         String   @id @default(cuid())
  targetType String              // "Post" | "PostComment" | "Club" | "User" | ...
  targetId   String
  reason     String              // why it landed in the queue
  source     String   @default("manual")  // "manual" | "auto_filter" | "user_report"
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED | REMOVED
  reviewerId String?
  reviewedAt DateTime?
  reviewNote String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// User-facing notification templates so admins don't hardcode email/in-app copy.
model NotificationTemplate {
  id          String   @id @default(cuid())
  key         String   @unique           // e.g. "welcome", "password_reset"
  channel     String                      // "email" | "in_app" | "both"
  subject     String?
  body        String                      // template string, {{var}} interpolated
  description String?
  isSystem    Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Operational alert surfaced in the admin overview. Emitted by anomaly
// detection, high-error-rate watchers, expiring-trials sweepers, etc.
model AdminAlert {
  id          String   @id @default(cuid())
  severity    String                      // "info" | "warning" | "critical"
  category    String                      // "security" | "billing" | "uptime" | "moderation"
  title       String
  body        String?
  link        String?                     // /admin/... destination
  metadata    Json?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt   DateTime @default(now())

  @@index([acknowledgedAt, createdAt])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// M5 Billing — provider-agnostic. `provider` records the source-of-truth
// system (stripe | razorpay | manual); when no provider is wired the rows
// are kept locally and can be reconciled when a provider is added later.
// ---------------------------------------------------------------------------

model Plan {
  id                String   @id @default(cuid())
  key               String   @unique               // "free" | "pro" | "team"
  name              String
  description       String?
  priceCents        Int      @default(0)
  currency          String   @default("USD")
  interval          String   @default("month")     // month | year | once
  trialDays         Int      @default(0)
  features          Json                            // ["creator_studio","ai_oracle"]
  isPublic          Boolean  @default(true)
  providerPriceId   String?                         // e.g. Stripe price_xxx
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  status          String   @default("ACTIVE")      // ACTIVE | TRIALING | PAST_DUE | CANCELED | PAUSED
  provider        String   @default("manual")      // stripe | razorpay | manual
  providerSubId   String?
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt     DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt      DateTime?
  pausedAt        DateTime?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([userId])
  @@index([status])
  @@index([providerSubId])
}

model Invoice {
  id               String   @id @default(cuid())
  subscriptionId   String
  amountCents      Int
  currency         String   @default("USD")
  status           String   @default("OPEN")       // OPEN | PAID | UNCOLLECTIBLE | VOID | REFUNDED
  paidAt           DateTime?
  refundedAmount   Int      @default(0)
  refundedAt       DateTime?
  refundReason     String?
  providerInvoiceId String?
  hostedInvoiceUrl String?
  failureReason    String?
  createdAt        DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([status])
}

// Audit row for every billing-provider webhook seen. Lets us replay
// reconciliation if we miss one.
model BillingEvent {
  id          String   @id @default(cuid())
  provider    String                                // stripe | razorpay
  eventType   String                                // invoice.paid | subscription.updated | ...
  eventId     String   @unique                      // provider's event id (dedupe)
  payload     Json
  processed   Boolean  @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([provider, eventType])
}

// ---------------------------------------------------------------------------
// M13 — scheduled / saved reports
// ---------------------------------------------------------------------------

model ReportSchedule {
  id          String   @id @default(cuid())
  name        String
  reportKey   String                                // identifies which report to generate
  cron        String                                // standard cron expression
  format      String   @default("csv")              // csv | json
  recipients  Json                                  // ["ops@kaiveron.com", "admin@..."]
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  lastResult  String?                               // "ok:rowcount=42" | "error:..."
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Security / inspection / moderation hardening
// ---------------------------------------------------------------------------

// Temporary IP block. Brute-force protection + admin manual ban. The
// auth middleware checks this table before processing a request.
model IpBlock {
  ip         String   @id
  reason     String                    // "bruteforce" | "manual" | "anomaly"
  blockedBy  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

// Auto-flag rule for content moderation. Posts/comments matching any
// active rule land in the moderation queue automatically.
model ContentRule {
  id          String   @id @default(cuid())
  name        String                    // human-readable
  kind        String                    // "keyword" | "regex" | "min_length" | "link_count"
  pattern     String                    // value depends on kind (the keyword, regex, threshold)
  target      String   @default("post") // "post" | "comment" | "blog" | "review"
  severity    String   @default("flag") // "flag" (queue) | "block" (refuse outright) | "shadow"
  enabled     Boolean  @default(true)
  matchCount  Int      @default(0)
  lastMatchAt DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, target])
}

// Hash of every flagged piece of content. Lets the matcher catch
// re-uses of previously-rejected text without re-running every rule.
model ContentFingerprint {
  hash        String   @id              // SHA-256 of normalized content
  targetType  String                    // "Post" | "Comment" | ...
  targetId    String
  matchedRule String?
  decision    String                    // "flag" | "removed" | "approved"
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
}

// Cached geolocation + ASN for an IP. Populated lazily by lib/geoip on
// first reference, refreshed weekly. Keeps the admin dashboard fast
// (single-row lookup) while geo data stays current enough for forensics.
model IpProfile {
  ip            String   @id
  country       String?                 // ISO-2 e.g. "US"
  countryName   String?
  region        String?
  city          String?
  latitude      Float?
  longitude     Float?
  isp           String?
  org           String?
  asn           String?
  isVpn         Boolean  @default(false)
  isProxy       Boolean  @default(false)
  isHosting     Boolean  @default(false) // datacenter / cloud IP
  lookupSource  String   @default("ip-api")
  lookupError   String?
  lastSeenAt    DateTime?               // updated whenever security events reference this IP
  refreshedAt   DateTime @default(now())

  @@index([country])
  @@index([asn])
  @@index([isVpn, isHosting])
}

// Detected anomalies. Different from AdminAlert (which is operator-facing
// notifications) — anomalies are per-user/per-IP forensic findings that
// power the /anomalies page and feed the risk score.
model AnomalyEvent {
  id            String   @id @default(cuid())
  kind          String                  // "impossible_travel" | "new_country" | "new_ip" |
                                         //   "ip_churn" | "concurrent_country" | "high_volume_signup_ip" |
                                         //   "vpn_login" | "new_device"
  severity      String   @default("info") // "info" | "warning" | "critical"
  userId        String?
  ipAddress     String?
  evidence      Json?                   // structured detail per kind
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([acknowledgedAt])
}

// ---------------------------------------------------------------------------
// Enterprise: incidents, maintenance, SLA metrics, saved replies
// ---------------------------------------------------------------------------

// Structured incident records with full lifecycle. Different from AdminAlert
// (which is a notification surface); an Incident is the THING that happens
// and gets a real post-mortem.
model Incident {
  id            String   @id @default(cuid())
  title         String
  severity      String                       // "sev1" | "sev2" | "sev3" | "sev4"
  status        String   @default("open")    // open | investigating | identified | monitoring | resolved
  category      String                       // "outage" | "degradation" | "security" | "data" | "billing"
  impactedAreas Json     @default("[]")      // ["auth","feed","search"]
  startedAt     DateTime @default(now())
  detectedAt    DateTime?                    // when ops first noticed
  resolvedAt    DateTime?
  postmortem    String?                      // markdown, written after-the-fact
  rootCause     String?                      // short summary
  openedBy      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  updates IncidentUpdate[]

  @@index([status, severity])
  @@index([startedAt])
}

// Append-only timeline of incident updates ("investigating", "identified the
// root cause", "rolled back deploy", "resolved"). Each update is itself a
// historical record.
model IncidentUpdate {
  id          String   @id @default(cuid())
  incidentId  String
  status      String                       // mirror of Incident.status at update time
  message     String                       // markdown
  authorId    String?
  createdAt   DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

// Scheduled maintenance. When `startsAt` ≤ now ≤ `endsAt`, the public
// /maintenance/current endpoint returns it; admin shell + the user-facing
// app should show a banner during the window.
model MaintenanceWindow {
  id          String   @id @default(cuid())
  title       String
  description String?
  scope       String   @default("all")     // "all" | "api" | "uploads" | "admin"
  startsAt    DateTime
  endsAt      DateTime
  cancelledAt DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt, endsAt])
}

// Rolling per-endpoint RED metrics aggregated by the SLA middleware. One row
// per (endpoint, hour) bucket — kept compact so charts stay fast.
model EndpointStat {
  id            String   @id @default(cuid())
  endpoint      String                      // "GET /api/v1/anime/:id"
  hourBucket    DateTime                    // truncated to the hour
  requests      Int      @default(0)
  errors        Int      @default(0)        // 5xx
  clientErrors  Int      @default(0)        // 4xx
  totalDurationMs BigInt @default(0)        // sum (for mean = total/requests)
  maxDurationMs Int      @default(0)
  // p50/p99 are stored as the result of in-process reservoir sampling. Not
  // exact, but good enough for an admin overview and cheap to compute.
  p50Ms         Int      @default(0)
  p99Ms         Int      @default(0)

  @@unique([endpoint, hourBucket])
  @@index([hourBucket])
  @@index([endpoint])
}

// Canned response library for support — small templates a moderator can
// drop into a reply with one click. Markdown body; {{vars}} replaced
// client-side by the operator.
model SavedReply {
  id          String   @id @default(cuid())
  title       String                       // short label shown in the picker
  body        String                       // markdown template
  category    String?                      // "billing" | "abuse" | "bug" | ...
  shortcut    String?  @unique             // e.g. "/refund" — for type-ahead pickers
  useCount    Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// PII inventory — every database column that may hold personal data, its
// classification, retention obligation, and which RBAC role is allowed to
// read it. Required for GDPR Article 30 records of processing. Auto-seeded
// from a known-field scanner; admins can override classification/retention.
model PiiField {
  id              String   @id @default(cuid())
  model           String                       // Prisma model name, e.g. "User"
  field           String                       // column name, e.g. "email"
  classification  String                       // "identifier" | "contact" | "sensitive" | "behavioral" | "device"
  legalBasis      String?                      // "consent" | "contract" | "legitimate_interest" | "legal_obligation"
  retentionDays   Int?                         // null = retain indefinitely; otherwise auto-purge by dataRetention job
  readRoleMin     String   @default("MOD")     // minimum role that may read this field directly
  description     String?                      // human note
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([model, field])
  @@index([classification])
}

// Two-person approval workflow. A subject action (delete user, transfer
// ownership, etc.) is materialized as an ApprovalRequest; the actor cannot
// approve their own request. Once approved, the original handler is allowed
// to proceed by checking ApprovalRequest.status == "approved" before
// performing the side effect.
model ApprovalRequest {
  id             String   @id @default(cuid())
  action         String                       // "users.delete" | "billing.refund" | ...
  resource       String                       // free-form: "user:abc" | "invoice:inv_123"
  payload        Json                         // serialized request body to replay on approve
  reason         String                       // why the actor requested this
  status         String   @default("pending") // pending | approved | rejected | expired | executed
  requestedBy    String                       // actor user id
  reviewedBy     String?                      // approver user id
  reviewedAt     DateTime?
  reviewNote     String?
  executedAt     DateTime?                    // when the original action actually ran post-approval
  expiresAt      DateTime                     // auto-expire after 24h by default
  createdAt      DateTime @default(now())
  decisions      ApprovalDecision[]

  @@index([status, expiresAt])
  @@index([requestedBy])
  @@index([action, status])
}

model ApprovalDecision {
  id          String   @id @default(cuid())
  requestId   String
  reviewerId  String
  decision    String                          // "approve" | "reject"
  note        String?
  createdAt   DateTime @default(now())

  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([reviewerId])
}

// Registered OAuth 2.0 client (third-party app / integration).
// Today we support client_credentials grant (app-to-app, no user context);
// authorization_code grant lands in a later batch when the consent UI is
// designed. Secret is stored as a one-way hash — admin sees plaintext only
// once at creation/rotation time.
model OauthClient {
  id              String   @id @default(cuid())
  name            String                                // human label, e.g. "Zapier"
  clientId        String   @unique                      // public identifier (prefix ka_oc_)
  clientSecretHash String                               // sha256(secret)
  type            String   @default("confidential")     // "confidential" | "public"
  scopes          String[] @default([])                 // "read:users" | "scim" | "webhooks:write" | ...
  redirectUris    String[] @default([])                 // for future authorization_code flow
  description     String?
  ownerEmail      String?                               // contact email for breach notifications
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accessTokens    OauthAccessToken[]

  @@index([revokedAt])
}

// Issued OAuth access token. Stored as a hash so a DB leak can't be used to
// forge calls. Refresh tokens are not part of client_credentials grant —
// the client just re-exchanges its secret for a new token.
model OauthAccessToken {
  id          String   @id @default(cuid())
  clientId    String                                    // FK to OauthClient.id
  tokenHash   String   @unique                          // sha256 of the bearer token
  scopes      String[] @default([])                     // granted at issuance (subset of client scopes)
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())

  client      OauthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([expiresAt])
}

// SCIM 2.0 subject mapping. An IdP (Okta, Azure AD, Google Workspace, etc.)
// addresses our users by its OWN identifier — typically a stable UUID it
// generated when the user was created in the IdP. We persist that mapping
// here rather than adding an externalId column to User, so SCIM stays an
// opt-in integration that can be removed without a User-table migration.
model ScimSubject {
  id          String   @id @default(cuid())
  externalId  String   @unique                          // IdP-provided id
  userId      String   @unique                          // local User.id (1-1)
  idpClientId String?                                   // OauthClient.id that provisioned this row
  meta        Json?                                     // raw IdP attrs we don't map (orgUnit, dept, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([idpClientId])
}

// SAML 2.0 SSO configuration. One row per IdP integration. Today we
// support a single active config (most enterprises have one IdP) — the
// `active` flag is enforced by application code, not a DB constraint, so
// we can keep historical configs around for audit.
model SamlConfig {
  id                String   @id @default(cuid())
  name              String                              // human label, e.g. "Okta Production"
  idpEntityId       String                              // urn:something from IdP metadata
  idpSsoUrl         String                              // where AuthnRequests are POSTed
  idpSloUrl         String?                             // optional single-logout endpoint
  idpCertificate    String                              // PEM-formatted X.509 (without headers ok too)
  spEntityId        String                              // our entityID — usually https://api.kaiveron.com/saml/metadata
  emailAttribute    String   @default("email")          // SAML attr name to read for the user's email
  displayNameAttr   String   @default("displayName")    // SAML attr name for the display name
  autoProvision     Boolean  @default(true)             // create new users on first login?
  active            Boolean  @default(false)            // exactly one active at a time (enforced app-side)
  signRequests      Boolean  @default(false)            // sign our AuthnRequests?
  wantAssertionsSigned Boolean @default(true)
  spPrivateKey      String?                             // PEM key for signing; null if signRequests=false
  spCertificate     String?                             // matching public cert
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active])
}

// FinOps — per-endpoint cost rate. Admins fill in cents-per-1k-requests
// based on infra observation; cost dashboard multiplies request volume
// from EndpointStat by these rates. Default: 0 (free) when no rate set.
model CostRate {
  id              String   @id @default(cuid())
  endpoint        String   @unique                 // "GET /api/v1/anime/:id" — must match EndpointStat.endpoint
  centsPer1k      Int      @default(0)             // cost of 1000 requests, in 1/100ths of a cent (so 1 = $0.0001)
  notes           String?
  category        String?                          // "db_heavy" | "ai" | "cache_hit" | etc — for grouping
  updatedBy       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// Monthly spend budget. Crossing the threshold raises an AdminAlert and
// (later) can trigger throttling. Single row per scope ("global" today;
// per-endpoint in a later batch).
model CostBudget {
  id              String   @id @default(cuid())
  scope           String   @unique                 // "global" today; "endpoint:GET /x" later
  monthlyBudgetCents BigInt                        // total budget in 1/100ths of a cent (kept consistent w/ CostRate)
  alertAtPct      Int      @default(80)            // raise warn alert at this % of budget
  hardCapAtPct    Int?                             // null = no hard cap (no enforcement today; placeholder)
  lastAlertAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Audit trail for SSO logins — useful for "did SSO actually work last week?"
// and for compliance reports. Distinct from SecurityEvent which covers
// password/OAuth logins.
model SamlLoginEvent {
  id          String   @id @default(cuid())
  configId    String                                    // FK to SamlConfig.id (no constraint — config can be deleted)
  userId      String?                                   // null if provisioning was rejected
  email       String?                                   // raw email from SAML
  outcome     String                                    // "success" | "rejected_provision" | "verification_failed" | "expired_assertion"
  ipAddress   String?
  userAgent   String?
  errorDetail String?
  createdAt   DateTime @default(now())

  @@index([configId, createdAt])
  @@index([userId])
}

